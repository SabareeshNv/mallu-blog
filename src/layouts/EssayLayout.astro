---
/**
 * An essay's own page: a full-width masthead (the cover illustration with the label, title and date set on it,
 * or the same on the plain background), then the text, its topics, related posts and links to the neighbouring posts.
 * The essay's rendered Markdown goes in the default slot.
 */
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import FormattedDate from '@/components/ui/FormattedDate.astro';
import PostSection from '@/components/feed/PostSection.astro';
import TopicLinks from '@/components/feed/TopicLinks.astro';
import ReadingProgress from '@/components/ui/ReadingProgress.astro';
import Prose from '@/components/ui/Prose.astro';
import EssayIcon from '@/components/icons/EssayIcon.astro';
import { getKeepReadingPosts, postDescription, readingMinutes, updatedDate, type Post } from '@/lib/content';
import { SITE } from '@/config/site';
import { isoDate } from '@/lib/format';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const minutes = readingMinutes(post);
const revised = updatedDate(post);
const related = await getKeepReadingPosts(post);
---

<BaseLayout
  title={title}
  description={postDescription(post)}
  image={cover}
  imageAlt={coverAlt}
  article={{ section: 'essay', publishedTime: date, modifiedTime: revised, tags: post.data.tags }}
>
  <ReadingProgress />
  <article
    class="essay"
    data-pagefind-body
    data-pagefind-filter="kind:Essay"
    data-pagefind-meta={`date:${isoDate(date)}`}
  >
    <header class:list={['masthead', { 'has-cover': cover }]}>
      {cover && (
        <>
          <Image
            class="photo"
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            data-fade
          />
          <div class="veil" aria-hidden="true" />
        </>
      )}
      <div class="masthead-inner">
        <p class="kind" data-pagefind-ignore>
          <EssayIcon size={20} />
          Essay
        </p>
        <h1 lang={SITE.postLang} data-pagefind-weight="5">
          {title}
        </h1>
        <p class="meta" data-pagefind-ignore>
          <FormattedDate date={date} />
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
          {revised && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <FormattedDate date={revised} />
              </span>
            </>
          )}
        </p>
      </div>
    </header>

    <Container size="reading" top={cover ? 'default' : 'tight'}>
      <div data-reading-target>
        <Prose size="large">
          <slot />
        </Prose>
      </div>
      <TopicLinks post={post} />
      <div data-pagefind-ignore>
        <PostSection heading="Keep reading" posts={related} />
      </div>
    </Container>
    {post.data.summary && (
      <span hidden data-pagefind-weight="2">
        {post.data.summary}
      </span>
    )}
    <span hidden data-pagefind-weight="3">
      {post.data.tags.join(' ')}
    </span>
  </article>
</BaseLayout>

<style>
  /* ---------- Masthead ---------- */
  .masthead {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
  }

  .masthead.has-cover {
    min-height: 28rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-image);
  }

  @media (min-width: 48rem) {
    .masthead.has-cover {
      min-height: 40rem;
    }
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Never lighter than 35%, so the label and title stay readable even on a bright picture. */
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--veil) 92%, transparent) 0%,
      color-mix(in srgb, var(--veil) 70%, transparent) 45%,
      color-mix(in srgb, var(--veil) 35%, transparent) 100%
    );
  }

  /* The label, title and date sit in a column a little wider than the text below, centred on the same axis.
     It is set in the reading font and size so that its "ch" width compares directly with the text column's;
     the label and date go back to the interface font. */
  .masthead-inner {
    width: 100%;
    min-width: 0;
    max-width: calc(var(--measure-masthead) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
    font-family: var(--font-post);
    font-size: var(--fs-lead);
  }

  .has-cover .masthead-inner {
    padding-block: var(--space-16) var(--space-12);
    text-shadow: var(--text-shadow-image);
  }

  .kind {
    font-family: var(--font-sans);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--essay);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .has-cover .kind {
    color: var(--sun);
  }

  /* Malayalam words are long; on phones the title is set at the section-heading size. */
  h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    line-height: var(--lh-h2);
    overflow-wrap: anywhere; /* safety net: a very long word never runs off the screen */
  }

  @media (min-width: 48rem) {
    h1 {
      font-size: var(--fs-display);
      line-height: var(--lh-display);
    }
  }

  .meta {
    font-family: var(--font-sans);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  .has-cover .meta {
    color: var(--on-image-muted);
  }
</style>
