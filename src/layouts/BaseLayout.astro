---
import { Font, getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import defaultShareImage from '../assets/images/hero-lake-dusk.jpg';
import { SITE } from '../site.config';

interface Props {
  /** Page title (without the site name). */
  title?: string;
  description?: string;
  /** Social preview image (an imported image). Defaults to the site's hero photograph. */
  image?: ImageMetadata;
  /** Alt text for the social preview image. */
  imageAlt?: string;
  type?: 'website' | 'article';
  /** For articles: publication date. */
  publishedTime?: Date;
}

const {
  title,
  description = SITE.description,
  image = defaultShareImage,
  imageAlt = 'A wooden jetty reaching into a calm lake at sunset',
  type = 'website',
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#15212c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081115" media="(prefers-color-scheme: dark)" />

    <!-- Social previews -->
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Apply the saved (or system) theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        root.dataset.js = '';
      })();
    </script>

    <Font cssVariable="--font-ui" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-ml" preload={[{ subset: 'malayalam' }]} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot name="hero" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <!-- Images marked data-fade sit on a placeholder colour and fade in once loaded. -->
    <script is:inline>
      (() => {
        const done = (img) => img.setAttribute('data-loaded', '');
        document.querySelectorAll('img[data-fade]').forEach((img) => {
          if (img.complete) return done(img);
          img.addEventListener('load', () => done(img), { once: true });
          img.addEventListener('error', () => done(img), { once: true });
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  /* =====================================================================
     Design tokens
     ===================================================================== */
  :root {
    /* ---- Spacing: a strict 4-point scale. No other values are used. ---- */
    --space-1: 0.25rem; /*  4 */
    --space-2: 0.5rem; /*  8 */
    --space-3: 0.75rem; /* 12 */
    --space-4: 1rem; /* 16 */
    --space-5: 1.25rem; /* 20 */
    --space-6: 1.5rem; /* 24 */
    --space-8: 2rem; /* 32 */
    --space-10: 2.5rem; /* 40 */
    --space-12: 3rem; /* 48 */
    --space-16: 4rem; /* 64 */
    --space-24: 6rem; /* 96 */

    /* ---- Layout ---- */
    --gutter: var(--space-4);
    --container-feed: 48rem; /* lists: Home, Essays, Scribbles, Archive */
    --container-prose: 42rem; /* reading: essays, scribbles, policies */
    --header-h: var(--space-16);
    --control-h: var(--space-10); /* buttons, nav links, theme switcher */
    --icon-button: var(--space-8);

    /* ---- Type: one family per script, one ramp, paired line heights on the 4-point grid ---- */
    --font-sans: var(--font-ui), system-ui, sans-serif;
    --font-post: var(--font-ml), var(--font-ui), sans-serif;

    --fw-regular: 400;
    --fw-bold: 700;
    --fw-heavy: 800;

    --fs-display: 2.5rem; /* page titles, hero */
    --lh-display: 3rem;
    --fs-h2: 1.75rem; /* section headings */
    --lh-h2: 2.25rem;
    --fs-h3: 1.25rem; /* card titles, in-article headings */
    --lh-h3: 1.75rem;
    --fs-lead: 1.25rem; /* hero tagline, long-form body */
    --lh-lead: 1.75rem;
    --fs-body: 1.125rem;
    --lh-body: 1.75rem;
    --fs-small: 1rem; /* navigation, buttons */
    --lh-small: 1.5rem;
    --fs-meta: 0.875rem; /* dates, footer */
    --lh-meta: 1.25rem;
    --fs-label: 0.75rem; /* uppercase labels and badges */
    --lh-label: 1rem;
    --tracking-label: 0.08em;

    /* ---- Shape ---- */
    --radius-sm: 4px; /* badges, code */
    --radius-md: 8px; /* images inside cards */
    --radius-lg: 12px; /* cards and panels */
    --radius-full: 999px; /* buttons, pills, icon buttons */
    --border-width: 1px;

    /* ---- Motion ---- */
    --ease: cubic-bezier(0.2, 0, 0, 1);
    --duration-fast: 150ms;
    --duration: 250ms;

    /* ---- Colour: the "monsoon" palette (light) ---- */
    --bg: #ffffff;
    --surface: #f2f7f6;
    --surface-strong: #e2eeec;
    --text: #15212c;
    --muted: #4b5a68;
    --border: #d9e4e2;
    --accent: #0a6c67; /* interface and scribbles */
    --accent-soft: #e0f1ee;
    --essay: #b8400f; /* essays */
    --essay-soft: #fcebe2;
    --sun: #f6c453; /* highlights on dark surfaces only */
    --rail: #cfe3df;
    --tint-scribble: #f0f7f5;
    --highlight: #fff0bf;
    --focus: #1d4ed8;
    --ink: #15212c; /* header and footer */
    --on-ink: #e6efee;
    --on-ink-muted: #a9bcbf;
    --on-image: #ffffff;
    --on-image-muted: rgb(255 255 255 / 0.86);
    --veil: 8 30 38;
    --text-shadow-image: 0 1px 12px rgb(0 0 0 / 0.4);
    --shadow-sm: 0 1px 2px rgb(21 33 44 / 0.08);
    --shadow-md: 0 2px 4px rgb(21 33 44 / 0.05), 0 12px 24px -8px rgb(10 60 66 / 0.2);

    color-scheme: light;
  }

  @media (min-width: 48rem) {
    :root {
      --gutter: var(--space-6);
      --fs-display: 3.25rem;
      --lh-display: 3.75rem;
      --fs-h2: 2rem;
      --lh-h2: 2.5rem;
      --fs-h3: 1.5rem;
      --lh-h3: 2rem;
    }
  }

  @media (min-width: 80rem) {
    :root {
      --gutter: var(--space-10);
    }
  }

  /* Malayalam's stacked glyphs need taller lines. The same tokens, redefined for any lang="ml" subtree. */
  :lang(ml) {
    font-family: var(--font-post);
    --lh-display: 3.5rem;
    --lh-h2: 2.75rem;
    --lh-h3: 2rem;
    --lh-lead: 2.25rem;
    --lh-body: 2rem;
    --lh-small: 1.75rem;
  }

  @media (min-width: 48rem) {
    :lang(ml) {
      --lh-display: 4.5rem;
      --lh-h2: 3rem;
      --lh-h3: 2.25rem;
    }
  }

  /* ---- Colour: dark ---- */
  :root[data-theme='dark'] {
    --bg: #0d181d;
    --surface: #13232a;
    --surface-strong: #1b3038;
    --text: #e6efed;
    --muted: #9cb0b1;
    --border: #22373e;
    --accent: #52d0c4;
    --accent-soft: #10332f;
    --essay: #ff9e6e;
    --essay-soft: #3a2219;
    --rail: #22403f;
    --tint-scribble: #112128;
    --highlight: #3a3418;
    --focus: #93c5fd;
    --ink: #081115;
    --on-ink-muted: #8fa6a8;
    --veil: 4 16 20;
    --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.4);
    --shadow-md: 0 2px 4px rgb(0 0 0 / 0.3), 0 12px 24px -8px rgb(0 0 0 / 0.6);
    color-scheme: dark;
  }

  /* Without JavaScript, follow the operating system. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --bg: #0d181d;
      --surface: #13232a;
      --surface-strong: #1b3038;
      --text: #e6efed;
      --muted: #9cb0b1;
      --border: #22373e;
      --accent: #52d0c4;
      --accent-soft: #10332f;
      --essay: #ff9e6e;
      --essay-soft: #3a2219;
      --rail: #22403f;
      --tint-scribble: #112128;
      --highlight: #3a3418;
      --focus: #93c5fd;
      --ink: #081115;
      --on-ink-muted: #8fa6a8;
      --veil: 4 16 20;
      --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.4);
      --shadow-md: 0 2px 4px rgb(0 0 0 / 0.3), 0 12px 24px -8px rgb(0 0 0 / 0.6);
      color-scheme: dark;
    }
  }

  /* =====================================================================
     Base
     ===================================================================== */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-padding-top: calc(var(--header-h) + var(--space-4));
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: var(--fw-regular);
    line-height: var(--lh-body);
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  main {
    flex: 1;
    width: 100%;
    outline: none;
  }

  img,
  picture,
  svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    text-wrap: balance;
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  /* Loading state for photographs: a placeholder colour, then a short fade once the image arrives. */
  html[data-js] img[data-fade] {
    opacity: 0;
    transition: opacity var(--duration) var(--ease);
  }

  html[data-js] img[data-fade][data-loaded] {
    opacity: 1;
  }

  .sr-only {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    display: inline-flex;
    align-items: center;
    height: var(--control-h);
    padding: 0 var(--space-4);
    border-radius: var(--radius-full);
    background: var(--text);
    color: var(--bg);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
