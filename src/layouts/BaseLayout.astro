---
import { Font } from 'astro:assets';
import Seo from '@/components/seo/Seo.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import themeInit from '@/scripts/theme-init.js?raw';
import imageFade from '@/scripts/image-fade.js?raw';
import type { ArticleMeta } from '@/lib/seo/types';
import '@/styles/tokens.css';
import '@/styles/theme.css';
import '@/styles/base.css';

/**
 * The frame of every page: <head> (SEO, icons, theme, fonts), skip link, header, an optional hero, <main>, footer.
 * Pages normally use it through PageLayout, EssayLayout or ScribbleLayout.
 */
interface Props {
  /** Page title (without the site name). */
  title?: string;
  description?: string;
  /** Social preview image. Defaults to the site's hero photograph. */
  image?: ImageMetadata;
  imageAlt?: string;
  /** Set for essays and scribbles. */
  article?: ArticleMeta;
  /** Keep the page out of search results. */
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {...Astro.props} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#15212c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#081115" media="(prefers-color-scheme: dark)" />

    <!-- Apply the saved (or system) theme before first paint to avoid a flash. -->
    <script is:inline set:html={themeInit} />

    <Font cssVariable="--font-ui" preload={[{ weight: '400', style: 'normal' }]} />
    <Font cssVariable="--font-ml" preload={[{ subset: 'malayalam' }]} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot name="hero" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <!-- Images marked data-fade sit on a placeholder colour and fade in once loaded. -->
    <script is:inline set:html={imageFade} />
  </body>
</html>
