---
/**
 * A scribble's own page: its date and text set large, its topics, a link back to it in the feed,
 * a few more scribbles, and the neighbouring posts.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PostNav from '@/components/feed/PostNav.astro';
import PostSection from '@/components/feed/PostSection.astro';
import ScribbleEntry from '@/components/feed/ScribbleEntry.astro';
import TopicLinks from '@/components/feed/TopicLinks.astro';
import { excerpt, getRecentScribbles, type Post } from '@/lib/content';
import { formatDate, isoDate } from '@/lib/format';

interface Props {
  post: Post;
  /** The scribble in its place in the feed. */
  streamUrl: string;
  newer?: Post;
  older?: Post;
}

const { post, streamUrl, newer, older } = Astro.props;
const date = formatDate(post.data.date);
const more = await getRecentScribbles(post.id);
---

<BaseLayout
  title={excerpt(post, 36)}
  description={excerpt(post, 110)}
  image={post.data.cover}
  imageAlt={post.data.coverAlt}
  article={{ section: 'scribble', publishedTime: post.data.date, tags: post.data.tags }}
>
  <Container size="reading">
    <h1 class="sr-only" data-pagefind-ignore>
      Scribble from {date}
    </h1>
    <div data-pagefind-body data-pagefind-meta={`title:${excerpt(post, 60)}`}>
      <span hidden data-pagefind-filter="kind:Scribble" data-pagefind-meta={`date:${isoDate(post.data.date)}`}></span>
      <ScribbleEntry post={post} variant="page" />
      <TopicLinks post={post} />
      <span hidden data-pagefind-weight="3">
        {post.data.tags.join(' ')}
      </span>
    </div>
    <p class="context">
      <a class="button" href={streamUrl}>
        See it in the stream <span aria-hidden="true">→</span>
      </a>
    </p>
    <PostSection heading="More scribbles" posts={more} />
    <PostNav newer={newer} older={older} />
  </Container>
</BaseLayout>

<style>
  .context {
    margin-top: var(--space-8);
    font-family: var(--font-sans);
  }

  /* Same button language as pagination: 40px pill, 1px border, bold small text. */
  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-h);
    padding: 0 var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
