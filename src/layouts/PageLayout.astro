---
/**
 * A page of English text (the policy pages): page header, then prose at reading width.
 */
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';

interface Props {
  title: string;
  description: string;
  /** e.g. "11 November 2026" */
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="page">
    <PageHeader title={title} intro={updated ? `Last updated ${updated}.` : undefined} />
    <Prose lang="en">
      <slot />
    </Prose>
  </article>
</BaseLayout>

<style>
  .page {
    width: 100%;
    max-width: calc(var(--container-prose) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
  }
</style>
