---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Feed from '@/components/feed/Feed.astro';
import { getSortedPosts, isScribble, type Post } from '@/lib/posts';
import { SITE } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  const scribbles = (await getSortedPosts()).filter(isScribble);
  return paginate(scribbles, { pageSize: SITE.feedPageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage === 1 ? 'Scribbles' : `Scribbles · Page ${page.currentPage}`}
  description={`Scribbles on ${SITE.title}: short untitled notes in Malayalam.`}
>
  <Feed
    page={page}
    title="Scribbles"
    intro={`Short notes without a title — ${page.total} so far, newest first.`}
    emptyText="No scribbles have been published yet."
  />
</BaseLayout>
