---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Feed from '../../components/Feed.astro';
import { getSortedPosts, isScribble, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const scribbles = (await getSortedPosts()).filter(isScribble);
  return paginate(scribbles, { pageSize: SITE.feedPageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage === 1 ? 'Scribbles' : `Scribbles · Page ${page.currentPage}`}
  description="Short notes without a title."
>
  <Feed
    page={page}
    eyebrow="Scribbles"
    heading="Small notes"
    intro={`${page.total} ${page.total === 1 ? 'scribble' : 'scribbles'}, newest first.`}
    emptyText="No scribbles yet."
  />
</BaseLayout>
