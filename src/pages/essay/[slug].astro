---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostNav from '../../components/PostNav.astro';
import Prose from '../../components/Prose.astro';
import EssayIcon from '../../components/icons/EssayIcon.astro';
import { excerpt, getSortedPosts, isEssay, postSlug, readingMinutes, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  const seen = new Map<string, string>();
  return posts.flatMap((post, i) => {
    if (!isEssay(post)) return [];
    const slug = postSlug(post);
    if (seen.has(slug)) {
      throw new Error(
        `Essays "${seen.get(slug)}" and "${post.id}" share the URL /essay/${slug}/. Add a unique "slug" to one of them.`,
      );
    }
    seen.set(slug, post.id);
    return [{ params: { slug }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }];
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const { Content } = await render(post);
const minutes = readingMinutes(post);
---

<BaseLayout
  title={title}
  description={excerpt(post, 150)}
  image={cover}
  imageAlt={coverAlt}
  type="article"
  publishedTime={date}
>
  <article class="essay">
    <header class:list={['masthead', { 'has-cover': cover }]}>
      {
        cover && (
          <>
            <Image
              class="photo"
              src={cover}
              alt={coverAlt ?? ''}
              widths={[640, 960, 1280, 1600, 2000]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              data-fade
            />
            <div class="veil" aria-hidden="true" />
          </>
        )
      }
      <div class="masthead-inner">
        <p class="kind">
          <EssayIcon size={16} />
          Essay
        </p>
        <h1 lang={SITE.postLang}>{title}</h1>
        <p class="meta">
          <FormattedDate date={date} />
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="body">
      <Prose size="large">
        <Content />
      </Prose>
      <PostNav newer={newer} older={older} />
    </div>
  </article>
</BaseLayout>

<style>
  /* ---------- Masthead ---------- */
  .masthead {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
  }

  .masthead.has-cover {
    min-height: 28rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-image);
  }

  @media (min-width: 48rem) {
    .masthead.has-cover {
      min-height: 40rem;
    }
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(var(--veil) / 0.9) 0%,
      rgb(var(--veil) / 0.55) 40%,
      rgb(var(--veil) / 0.15) 75%,
      rgb(var(--veil) / 0.05) 100%
    );
  }

  /* Same container as the article body, so the title and text share one left edge. */
  .masthead-inner {
    width: 100%;
    max-width: calc(var(--container-prose) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
  }

  .has-cover .masthead-inner {
    padding: var(--space-16) var(--gutter) var(--space-12);
    text-shadow: var(--text-shadow-image);
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--essay);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .has-cover .kind {
    color: var(--sun);
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-display);
    font-weight: var(--fw-bold);
    line-height: var(--lh-display);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .has-cover .meta {
    color: var(--on-image-muted);
  }

  /* ---------- Body ---------- */
  .body {
    width: 100%;
    max-width: calc(var(--container-prose) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
  }

  .masthead:not(.has-cover) + .body {
    padding-top: var(--space-8);
  }
</style>
