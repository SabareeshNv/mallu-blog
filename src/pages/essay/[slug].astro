---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostNav from '../../components/PostNav.astro';
import Prose from '../../components/Prose.astro';
import EssayIcon from '../../components/icons/EssayIcon.astro';
import { excerpt, getSortedPosts, isEssay, postSlug, readingMinutes, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts();
  const seen = new Map<string, string>();
  return posts.flatMap((post, i) => {
    if (!isEssay(post)) return [];
    const slug = postSlug(post);
    if (seen.has(slug)) {
      throw new Error(
        `Essays "${seen.get(slug)}" and "${post.id}" share the URL /essay/${slug}/. Add a unique "slug" to one of them.`,
      );
    }
    seen.set(slug, post.id);
    return [{ params: { slug }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }];
  });
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const { Content } = await render(post);
const minutes = readingMinutes(post);
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<BaseLayout title={title} description={excerpt(post, 150)} image={ogImage}>
  <article class="essay">
    <header class:list={['masthead', { 'has-cover': cover }]}>
      {
        cover && (
          <>
            <Image
              class="photo"
              src={cover}
              alt={coverAlt ?? ''}
              widths={[640, 960, 1280, 1600, 2000]}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
            />
            <div class="veil" aria-hidden="true" />
          </>
        )
      }
      <div class="masthead-inner">
        <p class="kind">
          <EssayIcon size={16} />
          Essay
        </p>
        <h1 lang={SITE.postLang}>{title}</h1>
        <p class="meta">
          <FormattedDate date={date} />
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </div>
    </header>

    <div class="body">
      <Prose size="large">
        <Content />
      </Prose>
      <PostNav newer={newer} older={older} />
    </div>
  </article>
</BaseLayout>

<style>
  /* ---------- Masthead ---------- */
  .masthead {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
  }

  .masthead.has-cover {
    min-height: clamp(22rem, 68vh, 40rem);
    overflow: hidden;
    color: #fff;
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo {
      animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.06);
      }
    }
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(var(--veil) / 0.9) 0%,
      rgb(var(--veil) / 0.55) 40%,
      rgb(var(--veil) / 0.15) 75%,
      rgb(var(--veil) / 0.05) 100%
    );
  }

  .masthead-inner {
    width: 100%;
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-s) var(--space-l);
  }

  .has-cover .masthead-inner {
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.5);
  }

  .masthead:not(.has-cover) .masthead-inner {
    padding-bottom: var(--space-m);
  }

  .kind {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 var(--space-xs);
    color: var(--essay);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .has-cover .kind {
    color: #f6c453;
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 700;
    line-height: 1.4;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: var(--space-xs) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .has-cover .meta {
    color: rgb(255 255 255 / 0.9);
  }

  /* ---------- Body ---------- */
  .body {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-l) var(--space-s) 0;
  }

  .masthead:not(.has-cover) + .body {
    padding-top: var(--space-s);
  }
</style>
