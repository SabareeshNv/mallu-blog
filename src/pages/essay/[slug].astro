---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import EssayLayout from '@/layouts/EssayLayout.astro';
import { getEssayEntries, postSlug, type PostEntry } from '@/lib/content';

export const getStaticPaths = (async () => {
  const entries = await getEssayEntries();
  return entries.map((entry) => ({ params: { slug: postSlug(entry.post) }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props;
const { Content } = await render(entry.post);
---

<EssayLayout post={entry.post} newer={entry.newer} older={entry.older}>
  <Content />
</EssayLayout>
