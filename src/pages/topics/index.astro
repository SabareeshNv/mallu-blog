---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import TopicList from '@/components/feed/TopicList.astro';
import { getTopics } from '@/lib/content';
import { countOf } from '@/lib/format';
import { SITE } from '@/config/site';

const topics = await getTopics();
---

<BaseLayout title="Topics" description={`Browse ${SITE.title} by subject: essays and scribbles grouped by topic.`}>
  <Container size="feed">
    <PageHeader
      title="Topics"
      intro={
        topics.length > 0
          ? `Browse by subject — ${countOf(topics.length, 'topic')}, the most written about first.`
          : 'No topics yet.'
      }
    />
    <TopicList topics={topics} />
  </Container>
</BaseLayout>
