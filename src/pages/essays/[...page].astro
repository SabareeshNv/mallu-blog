---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import EssayGrid from '@/components/feed/EssayGrid.astro';
import { getEssays, type Post } from '@/lib/content';
import { SITE } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  return paginate(await getEssays(), { pageSize: SITE.feedPageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage === 1 ? 'Essays' : `Essays · Page ${page.currentPage}`}
  description={`Essays on ${SITE.title}: longer pieces in Malayalam, each with a title.`}
>
  <EssayGrid
    page={page}
    title="Essays"
    intro={`Longer pieces, each with a title — ${page.total} so far, newest first.`}
    emptyText="No essays have been published yet."
  />
</BaseLayout>
