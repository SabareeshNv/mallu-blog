---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Feed from '@/components/feed/Feed.astro';
import { getSortedPosts, isEssay, type Post } from '@/lib/posts';
import { SITE } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  const essays = (await getSortedPosts()).filter(isEssay);
  return paginate(essays, { pageSize: SITE.feedPageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
---

<BaseLayout
  title={page.currentPage === 1 ? 'Essays' : `Essays · Page ${page.currentPage}`}
  description={`Essays on ${SITE.title}: longer pieces in Malayalam, each with a title.`}
>
  <Feed
    page={page}
    title="Essays"
    intro={`Longer pieces, each with a title — ${page.total} so far, newest first.`}
    emptyText="No essays have been published yet."
  />
</BaseLayout>
