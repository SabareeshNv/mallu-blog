---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Feed from '@/components/feed/Feed.astro';
import Hero from '@/components/home/Hero.astro';
import LatestEssay from '@/components/home/LatestEssay.astro';
import { getSortedPosts, splitFeatured, type Post } from '@/lib/content';
import { SITE } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: SITE.feedPageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const isFirst = page.currentPage === 1;
// On the first page the newest essay is featured above the timeline, and left out of the timeline itself.
const { featured, rest } = isFirst ? splitFeatured(page.data) : { featured: undefined, rest: page.data };
---

<BaseLayout title={isFirst ? undefined : `Earlier entries · Page ${page.currentPage}`}>
  {isFirst && <Hero slot="hero" />}
  <Feed
    page={{ ...page, data: rest }}
    title={isFirst ? undefined : 'Earlier entries'}
    intro={isFirst ? undefined : 'Older essays and scribbles, newest first.'}
    emptyText={featured ? '' : 'Nothing has been published yet.'}
  >
    {featured && <LatestEssay slot="before" post={featured} />}
  </Feed>
</BaseLayout>
