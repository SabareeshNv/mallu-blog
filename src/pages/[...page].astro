---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Feed from '@/components/feed/Feed.astro';
import Hero from '@/components/home/Hero.astro';
import HomeRail from '@/components/home/HomeRail.astro';
import HomeShell from '@/components/home/HomeShell.astro';
import { getSortedPosts, type Post } from '@/lib/content';
import { SITE } from '@/config/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: SITE.feedPageSize });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const isFirst = page.currentPage === 1;
---

<BaseLayout title={isFirst ? undefined : `Earlier entries · Page ${page.currentPage}`}>
  {isFirst && <Hero slot="hero" />}
  <HomeShell>
    <Feed
      flush
      page={page}
      title={isFirst ? undefined : 'Earlier entries'}
      intro={isFirst ? undefined : 'Older essays and scribbles, newest first.'}
      emptyText="Nothing has been published yet."
    />
    <HomeRail slot="rail" />
  </HomeShell>
</BaseLayout>
