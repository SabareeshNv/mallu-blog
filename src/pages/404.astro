---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <div class="missing">
    <PageHeader title="Page not found" intro="The link may be out of date, or the page may have been moved or removed." />
    <ul class="actions">
      <li><a class="button primary" href="/">Go to the latest entries</a></li>
      <li><a class="button" href="/archive/">Browse the archive</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .missing {
    width: 100%;
    max-width: calc(var(--container-prose) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Same button language as pagination: 40px pill, 1px border, bold small text. */
  .button {
    display: inline-flex;
    align-items: center;
    height: var(--control-h);
    padding: 0 var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .button.primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--text));
    color: var(--bg);
  }
</style>
