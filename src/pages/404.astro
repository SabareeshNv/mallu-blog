---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="missing">
    <p class="code">404</p>
    <h1>This page seems to have been torn out.</h1>
    <p>The link may be old, or the page never existed.</p>
    <p class="links"><a href="/">Back to the latest entries</a> · <a href="/archive/">Browse the archive</a></p>
  </div>
</BaseLayout>

<style>
  .missing {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-s) 0;
    text-align: center;
  }

  .code {
    margin: 0;
    color: var(--accent);
    font-size: var(--step-3);
    font-weight: 800;
  }

  h1 {
    margin: 0;
    font-size: var(--step-2);
  }

  p {
    color: var(--muted);
  }

  .links {
    font-weight: 700;
  }
</style>
