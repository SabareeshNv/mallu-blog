---
import type { GetStaticPaths } from 'astro';
import ScribbleLayout from '@/layouts/ScribbleLayout.astro';
import { getScribbleEntries, streamUrl, type PostEntry } from '@/lib/content';

export const getStaticPaths = (async () => {
  const entries = await getScribbleEntries();
  return entries.map((entry) => ({ params: { slug: entry.post.id }, props: { entry } }));
}) satisfies GetStaticPaths;

interface Props {
  entry: PostEntry;
}

const { entry } = Astro.props;
---

<ScribbleLayout post={entry.post} streamUrl={streamUrl(entry)} />
