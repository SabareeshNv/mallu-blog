---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveYear from '../../components/ArchiveYear.astro';
import Pagination from '../../components/Pagination.astro';
import { getSortedPosts, groupByYear, isEssay, type Post } from '../../lib/posts';
import { SITE } from '../../site.config';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getSortedPosts();
  const essays = posts.filter(isEssay).length;
  return paginate(posts, {
    pageSize: SITE.archivePageSize,
    props: { essays, scribbles: posts.length - essays },
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
  essays: number;
  scribbles: number;
}

const { page, essays, scribbles } = Astro.props;
const groups = groupByYear(page.data);
---

<BaseLayout
  title={page.currentPage === 1 ? 'Archive' : `Archive · Page ${page.currentPage}`}
  description="Every essay and scribble, year by year."
>
  <div class="archive">
    <header class="page-head">
      <p class="eyebrow">Archive</p>
      <h1>Everything, year by year</h1>
      <p class="summary">
        {`${essays} ${essays === 1 ? 'essay' : 'essays'} and ${scribbles} ${scribbles === 1 ? 'scribble' : 'scribbles'}, newest first.`}
      </p>
    </header>

    {groups.length === 0 && <p class="summary">The archive is empty for now.</p>}
    {groups.map((group) => <ArchiveYear group={group} />)}

    <Pagination
      current={page.currentPage}
      last={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </div>
</BaseLayout>

<style>
  .archive {
    max-width: var(--measure);
    margin-inline: auto;
    padding: var(--space-l) var(--space-s) 0;
  }

  .page-head {
    margin-bottom: var(--space-l);
  }

  .eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0.2rem 0 0;
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .summary {
    margin: var(--space-xs) 0 0;
    color: var(--muted);
  }
</style>
