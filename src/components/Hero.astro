---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-lake-dusk.jpg';
import { SITE } from '../site.config';

interface Props {
  /** Total number of entries, shown as a quiet stat. */
  count: number;
}

const { count } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="photo"
    src={heroImage}
    alt=""
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="veil" aria-hidden="true"></div>
  <div class="content">
    <p class="eyebrow">A notebook in Malayalam</p>
    <h1 id="hero-title">{SITE.title}</h1>
    <p class="tagline">{SITE.tagline}</p>
    <p class="meta">{count} {count === 1 ? 'entry' : 'entries'} so far</p>
  </div>
</section>

<style>
  /* A full-width photograph opens the notebook. */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: clamp(20rem, 55vh, 32rem);
    overflow: hidden;
    color: #fff;
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .photo {
      animation: settle 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    @keyframes settle {
      from {
        transform: scale(1.06);
      }
    }
  }

  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(var(--veil) / 0.9) 0%, rgb(var(--veil) / 0.5) 50%, rgb(var(--veil) / 0.08) 100%);
  }

  /* The text lines up with the feed column below. */
  .content {
    width: 100%;
    max-width: var(--feed);
    margin-inline: auto;
    padding: var(--space-xl) var(--space-s) var(--space-l);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.45);
  }

  .eyebrow {
    margin: 0 0 var(--space-xs);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f6c453;
  }

  h1 {
    margin: 0;
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .tagline {
    max-width: 34ch;
    margin: var(--space-xs) 0 0;
    font-size: var(--step-1);
  }

  .meta {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    opacity: 0.9;
  }
</style>
