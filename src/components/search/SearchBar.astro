---
/**
 * A search field shown above the posts. It looks like a field but opens the search dialog.
 * On the home page, `hideBesideRail` hides it from 1024px up, where the side column has the search instead.
 * Hidden when JavaScript is off.
 */
import SearchIcon from '@/components/icons/SearchIcon.astro';
interface Props {
  hideBesideRail?: boolean;
}

const { hideBesideRail = false } = Astro.props;
---

<button
  type="button"
  class:list={['searchbar', { 'beside-rail': hideBesideRail }]}
  data-search-open
  aria-keyshortcuts="Control+K Meta+K"
>
  <SearchIcon />
  <span>Search essays and scribbles</span>
</button>

<style>
  .searchbar {
    display: none;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    height: var(--space-12);
    margin-bottom: var(--space-8);
    padding: 0 var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--surface) 70%, var(--bg));
    box-shadow: var(--inset);
    color: var(--muted);
    font: inherit;
    font-size: var(--fs-small);
    text-align: start;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .searchbar:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(html[data-js]) .searchbar {
    display: flex;
  }

  @media (min-width: 64rem) {
    :global(html[data-js]) .searchbar.beside-rail {
      display: none;
    }
  }
</style>
