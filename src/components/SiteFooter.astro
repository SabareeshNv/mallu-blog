---
import GithubIcon from './icons/GithubIcon.astro';
import { SITE } from '../site.config';

const year = new Date().getFullYear();
const path = Astro.url.pathname;
const legal = [
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/content-policy/', label: 'Content Policy' },
];
const icons = { github: GithubIcon } as const;
---

<footer class="site-footer">
  <div class="inner">
    <p class="copy">© {year} {SITE.author}. Written in Malayalam.</p>
    <nav aria-label="Legal">
      <ul class="links">
        {
          legal.map((link) => (
            <li>
              <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      SITE.social.length > 0 && (
        <ul class="social" aria-label="Elsewhere">
          {SITE.social.map((profile) => {
            const Icon = icons[profile.icon];
            return (
              <li>
                <a href={profile.href} rel="me noopener" target="_blank" aria-label={`${profile.label} (opens in a new tab)`}>
                  <Icon />
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    --focus: #93c5fd;
    margin-top: var(--space-24);
    background: var(--ink);
    color: var(--on-ink-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
    padding: var(--space-8) var(--gutter);
  }

  .copy {
    margin-inline-end: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--on-ink);
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .social a {
    display: inline-grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border-radius: var(--radius-full);
    color: var(--on-ink);
    transition: background-color var(--duration-fast) var(--ease);
  }

  .social a:hover {
    background: rgb(255 255 255 / 0.1);
  }

  @media (max-width: 40rem) {
    .copy {
      flex-basis: 100%;
    }
  }
</style>
