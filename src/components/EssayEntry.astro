---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { excerpt, postAnchor, postUrl, type Post } from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const url = postUrl(post);
---

<article class:list={['essay', { 'has-cover': cover }]} id={postAnchor(post)}>
  {
    cover ? (
      <div class="cover">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 720, 1080, 1400]}
          sizes="(min-width: 48rem) 43rem, 100vw"
        />
        <h3 class="title" lang={SITE.postLang}>
          <a href={url}>{title}</a>
        </h3>
      </div>
    ) : (
      <h3 class="title" lang={SITE.postLang}>
        <a href={url}>{title}</a>
      </h3>
    )
  }
  <div class="text">
    <p class="summary" lang={SITE.postLang}>{excerpt(post, 90)}</p>
    <p class="meta">
      <span class="kind">Essay</span>
      <span aria-hidden="true">·</span>
      <FormattedDate date={date} />
    </p>
  </div>
</article>

<style>
  .essay {
    position: relative;
    padding: var(--space-s) 0;
  }

  .title {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.5;
  }

  .title a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--essay) 45%, transparent);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.3em;
    text-decoration-skip-ink: none;
    transition: text-decoration-color 0.2s ease;
  }

  /* Stretch the link over the whole entry for a generous click target. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .essay:hover .title a {
    text-decoration-color: var(--essay);
  }

  .title a:focus-visible {
    outline: none;
  }

  .essay:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 6px;
    border-radius: 6px;
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    margin: var(--space-xs) 0 0;
    color: var(--muted);
  }

  .meta {
    display: flex;
    gap: 0.4rem;
    margin: var(--space-xs) 0 0;
    color: var(--muted);
    font-size: var(--step--1);
  }

  .kind {
    color: var(--essay);
    font-weight: 700;
  }

  /* ---------- With a cover: the photo spans the card, the title sits on it, the text follows below ---------- */
  .essay.has-cover {
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    box-shadow: var(--shadow);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .essay.has-cover:hover {
      transform: translateY(-2px);
    }
  }

  .essay.has-cover:has(.title a:focus-visible) {
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  .cover {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    aspect-ratio: 16 / 8;
    min-height: 13rem;
    overflow: hidden;
    background: var(--surface);
  }

  .cover :global(img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .essay:hover .cover :global(img) {
      transform: scale(1.04);
    }
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(var(--veil) / 0.85) 0%,
      rgb(var(--veil) / 0.45) 35%,
      rgb(var(--veil) / 0) 70%
    );
  }

  .has-cover .title {
    padding: var(--space-l) var(--space-m) var(--space-s);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.45);
  }

  .has-cover .title a {
    color: #fff;
    text-decoration-color: rgb(246 196 83 / 0.75);
  }

  .essay.has-cover:hover .title a {
    text-decoration-color: #f6c453;
  }

  .has-cover .text {
    padding: var(--space-s) var(--space-m) var(--space-m);
  }

  .has-cover .summary {
    margin-top: 0;
  }

  @media (max-width: 40rem) {
    .title {
      font-size: var(--step-1);
    }

    .cover {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .has-cover .title {
      padding: var(--space-m) var(--space-s) var(--space-s);
    }

    .has-cover .text {
      padding: var(--space-s);
    }
  }
</style>
