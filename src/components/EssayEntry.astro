---
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import { excerpt, postAnchor, postUrl, type Post } from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, cover, coverAlt } = post.data;
const url = postUrl(post);
---

<article class:list={['essay', { 'has-cover': cover }]} id={postAnchor(post)}>
  {
    cover ? (
      <div class="cover">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 720, 1080, 1400]}
          sizes="(min-width: 48rem) 43rem, 100vw"
          data-fade
        />
        <h3 class="title" lang={SITE.postLang}>
          <a href={url}>{title}</a>
        </h3>
      </div>
    ) : (
      <h3 class="title" lang={SITE.postLang}>
        <a href={url}>{title}</a>
      </h3>
    )
  }
  <div class="text">
    <p class="summary" lang={SITE.postLang}>{excerpt(post, 90)}</p>
    <p class="meta">
      <span class="kind">Essay</span>
      <span aria-hidden="true">·</span>
      <FormattedDate date={date} />
    </p>
  </div>
</article>

<style>
  .essay {
    position: relative;
    padding-top: var(--space-5);
  }

  .title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: var(--lh-h3);
  }

  .title a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--essay) 45%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    text-decoration-skip-ink: none;
    transition: text-decoration-color var(--duration-fast) var(--ease);
  }

  /* Stretch the link over the whole entry for a generous click target. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .essay:hover .title a {
    text-decoration-color: var(--essay);
  }

  .title a:focus-visible {
    outline: none;
  }

  .essay:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: var(--space-1);
    border-radius: var(--radius-lg);
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    margin-top: var(--space-2);
    color: var(--muted);
  }

  .meta {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .kind {
    color: var(--essay);
    font-weight: var(--fw-bold);
  }

  /* ---------- With a cover: the photo spans the card, the title sits on it, the text follows ---------- */
  .essay.has-cover {
    padding-top: 0;
    overflow: hidden;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
    transition:
      box-shadow var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .essay.has-cover:hover {
    border-color: color-mix(in srgb, var(--essay) 30%, var(--border));
    box-shadow: var(--shadow-md);
  }

  .cover {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--surface-strong);
  }

  .cover :global(img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(var(--veil) / 0.85) 0%, rgb(var(--veil) / 0.45) 35%, rgb(var(--veil) / 0) 70%);
  }

  .has-cover .title {
    padding: var(--space-12) var(--space-6) var(--space-4);
    text-shadow: var(--text-shadow-image);
  }

  .has-cover .title a {
    color: var(--on-image);
    text-decoration-color: color-mix(in srgb, var(--sun) 70%, transparent);
  }

  .essay.has-cover:hover .title a {
    text-decoration-color: var(--sun);
  }

  .has-cover .text {
    padding: var(--space-4) var(--space-6) var(--space-6);
  }

  .has-cover .summary {
    margin-top: 0;
  }

  @media (max-width: 40rem) {
    .cover {
      aspect-ratio: 4 / 3;
    }

    .has-cover .title {
      padding: var(--space-8) var(--space-4) var(--space-4);
    }

    .has-cover .text {
      padding: var(--space-4);
    }
  }
</style>
