---
import ThemeSwitcher from './ThemeSwitcher.astro';
import LogoMark from './icons/LogoMark.astro';
import { SITE } from '../site.config';

const section = Astro.url.pathname.split('/')[1] ?? '';
const links = [
  { href: '/', label: 'Home', active: section === '' || (/^\d+$/.test(section) && section !== '404') },
  { href: '/essays/', label: 'Essays', active: section === 'essays' || section === 'essay' },
  { href: '/scribbles/', label: 'Scribbles', active: section === 'scribbles' || section === 'scribble' },
  { href: '/archive/', label: 'Archive', active: section === 'archive' },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label={`${SITE.title} — home`}>
      <LogoMark />
      <span class="name">{SITE.title}</span>
    </a>
    <div class="end">
      <nav aria-label="Main">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeSwitcher />
    </div>
  </div>
</header>

<style>
  /* A deep-ink band frames the page, matching the footer. Local tokens recolour everything inside it. */
  .site-header {
    --text: var(--on-ink);
    --muted: var(--on-ink-muted);
    --surface: rgb(255 255 255 / 0.06);
    --surface-strong: rgb(255 255 255 / 0.14);
    --border: rgb(255 255 255 / 0.14);
    --focus: #93c5fd;
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--ink);
    color: var(--text);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-size: var(--fs-lead);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-lead);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .end {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    height: var(--control-h);
    padding: 0 var(--space-4);
    border-radius: var(--radius-full);
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  nav a:hover {
    color: var(--text);
    background: var(--surface);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-strong);
    box-shadow: inset 0 -2px 0 var(--sun);
  }

  @media (max-width: 48rem) {
    .end {
      gap: var(--space-2);
    }

    ul {
      gap: 0;
    }

    nav a {
      padding: 0 var(--space-3);
    }
  }

  @media (max-width: 30rem) {
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    nav a {
      padding: 0 var(--space-2);
      font-size: var(--fs-meta);
    }
  }
</style>
