---
import ThemeSwitcher from './ThemeSwitcher.astro';
import LogoMark from './icons/LogoMark.astro';
import { SITE } from '../site.config';

const section = Astro.url.pathname.split('/')[1] ?? '';
const links = [
  { href: '/', label: 'Home', active: section === '' || (/^\d+$/.test(section) && section !== '404') },
  { href: '/essays/', label: 'Essays', active: section === 'essays' || section === 'essay' },
  { href: '/scribbles/', label: 'Scribbles', active: section === 'scribbles' || section === 'scribble' },
  { href: '/archive/', label: 'Archive', active: section === 'archive' },
];
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label={`${SITE.title} — home`}>
      <LogoMark />
      <span class="name">{SITE.title}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.active ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeSwitcher />
  </div>
</header>

<style>
  /* The header sits on the page itself: the page background, one hairline beneath, and nothing else. */
  .site-header {
    --bar-h: var(--space-16);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    box-shadow: 0 var(--border-width) 0 var(--border);
    transition: background-color var(--duration) var(--ease);
  }

  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'brand nav switcher';
    align-items: center;
    column-gap: var(--space-6);
    min-height: var(--bar-h);
    padding-inline: var(--gutter);
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text);
    font-size: var(--fs-lead);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-lead);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  nav {
    grid-area: nav;
    justify-self: end;
    align-self: stretch;
  }

  :global(.site-header) .inner > :global(.switcher) {
    grid-area: switcher;
  }

  ul {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Plain text links. The current page is marked with a bar that sits on the header's bottom line,
     and the same bar slides in from the left when you hover or focus a link. */
  nav a {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding-inline: var(--space-4);
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }

  nav a::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-4);
    bottom: calc(-1 * var(--border-width));
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--text);
  }

  nav a:hover::after,
  nav a:focus-visible::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: var(--fw-bold);
  }

  nav a:focus-visible {
    outline-offset: calc(-1 * var(--space-2));
  }

  /* ---------- Phones: logo and theme switch on one row, the four links on a row of their own ---------- */
  @media (max-width: 40rem) {
    .site-header {
      position: relative; /* two rows would take too much of a small screen if they stayed fixed */
    }

    .inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand switcher'
        'nav nav';
      row-gap: 0;
    }

    .brand {
      height: var(--space-16);
    }

    nav {
      justify-self: stretch;
      height: var(--space-10);
      margin-inline: calc(-1 * var(--space-4));
      border-top: var(--border-width) solid var(--border);
      padding-inline: var(--space-1);
    }

    nav a {
      padding-inline: var(--space-3);
    }

    nav a::after {
      inset-inline: var(--space-3);
    }
  }
</style>
