---
import { excerpt, isEssay, postUrl, type Post } from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  newer?: Post;
  older?: Post;
}

const { newer, older } = Astro.props;
const label = (post: Post) => (isEssay(post) ? post.data.title! : excerpt(post, 48));
const kind = (post: Post) => (isEssay(post) ? 'essay' : 'scribble');
---

{
  (newer || older) && (
    <nav class="post-nav" aria-label="More entries">
      {newer ? (
        <a class="newer" href={postUrl(newer)} rel="prev">
          <span class="dir">← Newer {kind(newer)}</span>
          <span class="name" lang={SITE.postLang}>
            {label(newer)}
          </span>
        </a>
      ) : (
        <span />
      )}
      {older ? (
        <a class="older" href={postUrl(older)} rel="next">
          <span class="dir">Older {kind(older)} →</span>
          <span class="name" lang={SITE.postLang}>
            {label(older)}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--border);
  }

  /* Plain text links: a small direction label and the title. No frame. */
  a {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    color: var(--text);
    text-decoration: none;
  }

  .name {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--duration-fast) var(--ease);
  }

  a:hover .name {
    text-decoration-color: var(--accent);
  }

  .older {
    text-align: end;
  }

  .dir {
    color: var(--accent);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .name {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
  }

  @media (max-width: 40rem) {
    .post-nav {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .older {
      text-align: start;
    }
  }
</style>
