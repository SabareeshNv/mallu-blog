---
import { excerpt, isEssay, postUrl, type Post } from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  newer?: Post;
  older?: Post;
}

const { newer, older } = Astro.props;
const label = (post: Post) => (isEssay(post) ? post.data.title! : excerpt(post, 48));
const kind = (post: Post) => (isEssay(post) ? 'essay' : 'scribble');
---

{
  (newer || older) && (
    <nav class="post-nav" aria-label="More entries">
      {newer ? (
        <a class="newer" href={postUrl(newer)} rel="prev">
          <span class="dir">← Newer {kind(newer)}</span>
          <span class="name" lang={SITE.postLang}>
            {label(newer)}
          </span>
        </a>
      ) : (
        <span />
      )}
      {older ? (
        <a class="older" href={postUrl(older)} rel="next">
          <span class="dir">Older {kind(older)} →</span>
          <span class="name" lang={SITE.postLang}>
            {label(older)}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  a {
    display: grid;
    gap: 0.2rem;
    padding: var(--space-s);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
  }

  a:hover {
    border-color: var(--accent);
  }

  .older {
    text-align: end;
  }

  .dir {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .name {
    font-weight: 700;
    line-height: 1.6;
  }

  @media (max-width: 34rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .older {
      text-align: start;
    }
  }
</style>
