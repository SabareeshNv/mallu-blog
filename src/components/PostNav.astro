---
import { excerpt, isEssay, postUrl, type Post } from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  newer?: Post;
  older?: Post;
}

const { newer, older } = Astro.props;
const label = (post: Post) => (isEssay(post) ? post.data.title! : excerpt(post, 48));
const kind = (post: Post) => (isEssay(post) ? 'essay' : 'scribble');
---

{
  (newer || older) && (
    <nav class="post-nav" aria-label="More entries">
      {newer ? (
        <a class="newer" href={postUrl(newer)} rel="prev">
          <span class="dir">← Newer {kind(newer)}</span>
          <span class="name" lang={SITE.postLang}>
            {label(newer)}
          </span>
        </a>
      ) : (
        <span />
      )}
      {older ? (
        <a class="older" href={postUrl(older)} rel="next">
          <span class="dir">Older {kind(older)} →</span>
          <span class="name" lang={SITE.postLang}>
            {label(older)}
          </span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--border);
  }

  /* Same card language as essay cards: 1px border, large radius, elevation only on hover. */
  a {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  a:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow-md);
  }

  .older {
    text-align: end;
  }

  .dir {
    color: var(--muted);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .name {
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
  }

  @media (max-width: 40rem) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .older {
      text-align: start;
    }
  }
</style>
