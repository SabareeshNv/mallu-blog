---
/**
 * A paginated stream of entries grouped by month, used by Home, Essays and Scribbles.
 */
import type { Page } from 'astro';
import MonthGroup from './MonthGroup.astro';
import PageHeader from './PageHeader.astro';
import Pagination from './Pagination.astro';
import { groupByMonth, type Post } from '../lib/posts';

interface Props {
  page: Page<Post>;
  /** Visible page title. When omitted, a hidden heading is used (the hero provides the visible one). */
  title?: string;
  intro?: string;
  emptyText?: string;
}

const { page, title, intro, emptyText = 'Nothing here yet.' } = Astro.props;
const groups = groupByMonth(page.data);
const pageNote = page.lastPage > 1 ? `Page ${page.currentPage} of ${page.lastPage}.` : '';
const lead = [intro, pageNote].filter(Boolean).join(' ');
---

<div class="feed">
  {title ? <PageHeader title={title} intro={lead} /> : <h2 class="sr-only">Latest entries</h2>}

  {groups.length === 0 && <p class="empty">{emptyText}</p>}
  {groups.map((group) => <MonthGroup group={group} />)}

  <Pagination current={page.currentPage} last={page.lastPage} prevUrl={page.url.prev} nextUrl={page.url.next} />
</div>

<style>
  .feed {
    width: 100%;
    max-width: calc(var(--container-feed) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
  }

  .empty {
    color: var(--muted);
  }
</style>
