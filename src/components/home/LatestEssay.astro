---
/**
 * The newest essay, set large at the top of the home feed so a visitor sees the writing straight away.
 */
import EssayEntry from '@/components/feed/EssayEntry.astro';
import type { Post } from '@/lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<section class="latest" aria-labelledby="latest-heading">
  <h2 id="latest-heading">Latest essay</h2>
  <EssayEntry post={post} variant="featured" />
</section>

<style>
  .latest {
    margin-bottom: var(--space-16);
  }

  h2 {
    margin-bottom: var(--space-4);
    color: var(--essay);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
</style>
