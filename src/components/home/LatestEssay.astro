---
/**
 * The newest essay, set large at the top of the home feed so a visitor sees the writing straight away.
 */
import EssayEntry from '@/components/feed/EssayEntry.astro';
import type { Post } from '@/lib/content';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<section class="latest" aria-labelledby="latest-heading">
  <h2 id="latest-heading">Latest essay</h2>
  <EssayEntry post={post} variant="featured" />
</section>

<style>
  .latest {
    margin-bottom: var(--space-16);
  }

  h2 {
    margin-bottom: var(--space-4);
    color: var(--essay);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* The featured photograph floats highest. */
  .latest :global(.cover) {
    box-shadow: var(--depth-2);
  }

  /* On large screens it is pulled up over the hero's bottom edge (the container above adds --space-12 of padding),
     so the photograph straddles the hero and the page. The label then sits on the hero, so it turns gold. */
  @media (min-width: 64rem) {
    .latest {
      position: relative;
      z-index: 1;
      margin-top: calc(-1 * (var(--overlap) + var(--space-12)));
    }

    h2 {
      color: var(--sun);
      text-shadow: var(--text-shadow-image);
    }
  }
</style>
