---
/**
 * The home page's side column: search, a short About, topics with their counts, and the RSS feed.
 * Beside the writing on wide screens; below it on narrower ones.
 */
import RssIcon from '@/components/icons/RssIcon.astro';
import SearchIcon from '@/components/icons/SearchIcon.astro';
import { ROUTES } from '@/config/routes';
import { SITE } from '@/config/site';
import { getTopics, topicUrl } from '@/lib/content';

const topics = await getTopics();
---

<aside class="rail" aria-label="About and topics">
  <button type="button" class="search" data-search-open aria-keyshortcuts="Control+K Meta+K">
    <SearchIcon />
    <span>Search</span>
    <kbd>Ctrl K</kbd>
  </button>

  <section aria-labelledby="rail-about">
    <h2 id="rail-about">About</h2>
    <p>{SITE.description}</p>
    <a class="link" href={ROUTES.about}>
      About this notebook <span aria-hidden="true">→</span>
    </a>
  </section>

  {topics.length > 0 && (
    <section aria-labelledby="rail-topics">
      <h2 id="rail-topics">Topics</h2>
      <ul role="list">
        {topics.map((topic) => (
          <li>
            <a href={topicUrl(topic)}>
              <span lang={SITE.postLang}>{topic.name}</span>
              <span class="count">{topic.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
      <a class="link" href={ROUTES.topics}>
        All topics <span aria-hidden="true">→</span>
      </a>
    </section>
  )}

  <section aria-labelledby="rail-follow">
    <h2 id="rail-follow">Follow</h2>
    <a class="link" href={ROUTES.rss}>
      <RssIcon />
      RSS feed
    </a>
  </section>
</aside>

<style>
  /* A tonal band: below the writing it is a full-width strip that meets the footer; beside the writing it is a
     column that fills the page's height and runs off the right edge. (The footer's top margin, --space-24, is
     cancelled by the negative bottom margin and paid back as padding.) */
  .rail {
    position: relative;
    display: grid;
    gap: var(--space-8);
    margin: var(--space-16) 0 calc(-1 * var(--space-24));
    padding: var(--space-12) 0 calc(var(--space-12) + var(--space-24));
    background: var(--surface);
    box-shadow: 0 0 0 100vmax var(--surface);
    clip-path: inset(0 -100vmax);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  /* The edge facing the writing is a soft wave: along the top of the strip, down the left side of the column. */
  .rail::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100vmax;
    width: calc(100% + 200vmax);
    height: var(--wave-height);
    background: var(--bg);
    mask: var(--wave-foot) repeat-x 0 0 / var(--wave-length) var(--wave-height);
  }

  @media (min-width: 64rem) {
    .rail {
      margin-top: calc(-1 * var(--space-12));
      padding-inline-start: var(--space-8);
      align-content: start;
      clip-path: inset(0 -100vmax 0 0);
    }

    .rail::before {
      top: 0;
      bottom: 0;
      left: 0;
      width: var(--wave-height);
      height: auto;
      mask: var(--wave-side) repeat-y 0 0 / var(--wave-height) var(--wave-length);
      scale: -1 1;
    }
  }

  /* Search lives here only beside the writing; below that width the bar above the posts has it. */
  .search {
    display: none;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    height: var(--space-12);
    padding: 0 var(--space-4);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    background: var(--bg);
    color: var(--muted);
    font: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .search span {
    flex: 1;
    text-align: start;
  }

  .search:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    :global(html[data-js]) .search {
      display: flex;
    }
  }

  kbd {
    padding: 0 var(--space-2);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tracking-label);
  }

  h2 {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--border-thick) solid var(--accent);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  p {
    margin: 0;
    color: var(--muted);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: var(--border-width) solid var(--border);
    color: var(--text);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }

  li a:hover {
    color: var(--accent);
  }

  .count {
    color: var(--muted);
    font-size: var(--fs-meta);
    font-weight: var(--fw-regular);
  }

  .link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h);
    color: var(--accent);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }

  .link:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
</style>
