---
import { Image } from 'astro:assets';
import heroImage from '@/assets/images/hero-lake-dusk.jpg';
import { SITE } from '@/config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="photo"
    src={heroImage}
    alt=""
    widths={[640, 960, 1280, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    data-fade
  />
  <div class="content">
    <p class="eyebrow">A notebook in Malayalam</p>
    <h1 id="hero-title">{SITE.title}</h1>
    <p class="tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 20rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-image);
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: 24rem;
    }
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The script below slides this as the page scrolls (parallax); 60% is where the photograph rests. */
    object-position: center var(--photo-y, 60%);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--veil) 90%, transparent) 0%,
      color-mix(in srgb, var(--veil) 50%, transparent) 50%,
      color-mix(in srgb, var(--veil) 10%, transparent) 100%
    );
  }

  /* Same container as the home page's two columns below (HomeShell), so the text starts where the posts start. */
  .content {
    width: 100%;
    max-width: calc(var(--container-wide) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-16) var(--gutter) var(--space-12);
    text-shadow: var(--text-shadow-image);
  }

  /* Beside the side column (1024px and up) the latest essay overlaps the hero's bottom edge; the bottom padding keeps
     the text clear of it. Below that the search bar sits there instead, so there is no overlap. */
  @media (min-width: 64rem) {
    .content {
      padding-bottom: calc(var(--overlap) + var(--space-6));
    }
  }

  .eyebrow {
    color: var(--sun);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-display);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-display);
    letter-spacing: -0.02em;
  }

  .tagline {
    max-width: 32rem;
    margin-top: var(--space-3);
    color: var(--on-image-muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }
</style>

<script>
  // Parallax. The photograph's box never changes; as the page scrolls, the visible part of the picture slides, so the
  // picture seems to move more slowly than the text over it. It needs spare picture to slide, so it shows only where the
  // hero crops the photograph (wide screens), and not when the reader has asked for reduced motion.
  const REST = 60; // where the photograph rests, as a percentage (matches the CSS)
  const SPEED = 0.3; // the picture drifts by this fraction of the scroll distance

  const hero = document.querySelector<HTMLElement>('.hero');
  const photo = hero?.querySelector<HTMLImageElement>('.photo');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && photo) {
    let queued = false;

    const update = () => {
      queued = false;
      const { clientWidth: boxW, clientHeight: boxH, naturalWidth, naturalHeight } = photo;
      if (reduced.matches || !naturalWidth) return hero.style.removeProperty('--photo-y');
      // The picture is scaled to cover the box (object-fit: cover); what is left over vertically is the room to slide.
      const slack = naturalHeight * Math.max(boxW / naturalWidth, boxH / naturalHeight) - boxH;
      if (slack <= 0) return hero.style.removeProperty('--photo-y');
      const drift = Math.min(scrollY, hero.offsetHeight) * SPEED;
      hero.style.setProperty('--photo-y', `${Math.max(0, REST - (100 * drift) / slack)}%`);
    };

    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    reduced.addEventListener('change', schedule);
    photo.addEventListener('load', schedule);
    update();
  }
</script>
