---
import { Image } from 'astro:assets';
import heroImage from '@/assets/images/hero-lake-dusk.jpg';
import { SITE } from '@/config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="photo"
    src={heroImage}
    alt=""
    widths={[640, 960, 1280, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    data-fade
  />
  <div class="content">
    <p class="eyebrow">A notebook in Malayalam</p>
    <h1 id="hero-title">{SITE.title}</h1>
    <p class="tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 26rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-image);
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: 32rem;
    }
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--veil) 90%, transparent) 0%,
      color-mix(in srgb, var(--veil) 50%, transparent) 50%,
      color-mix(in srgb, var(--veil) 10%, transparent) 100%
    );
  }

  /* Same container as the feed below, so the text lines up with the timeline. */
  .content {
    width: 100%;
    max-width: calc(var(--container-feed) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-16) var(--gutter) var(--space-12);
    text-shadow: var(--text-shadow-image);
  }

  .eyebrow {
    color: var(--sun);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-display);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-display);
    letter-spacing: -0.02em;
  }

  .tagline {
    max-width: 32rem;
    margin-top: var(--space-3);
    color: var(--on-image-muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }
</style>
