---
import { Image } from 'astro:assets';
import heroImage from '@/assets/images/hero-lake-dusk.jpg';
import { SITE } from '@/config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <Image
    class="photo"
    src={heroImage}
    alt=""
    widths={[640, 960, 1280, 1600, 2000]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    data-fade
  />
  <div class="content">
    <p class="eyebrow">A notebook in Malayalam</p>
    <h1 id="hero-title">{SITE.title}</h1>
    <p class="tagline">{SITE.tagline}</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 20rem;
    overflow: hidden;
    background: var(--ink);
    color: var(--on-image);
  }

  @media (min-width: 48rem) {
    .hero {
      min-height: 24rem;
    }
  }

  .photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  /* A veil keeps the words readable: darker towards the foot, and (on wider screens) darker on the text's side, so
     the boatman and the lantern on the other side stay bright. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--veil) 86%, transparent) 0%,
      color-mix(in srgb, var(--veil) 56%, transparent) 55%,
      color-mix(in srgb, var(--veil) 6%, transparent) 100%
    );
  }

  @media (min-width: 48rem) {
    .hero::before {
      background:
        radial-gradient(
          ellipse 75% 130% at 0% 100%,
          color-mix(in srgb, var(--veil) 88%, transparent) 0%,
          color-mix(in srgb, var(--veil) 66%, transparent) 45%,
          color-mix(in srgb, var(--veil) 0%, transparent) 100%
        ),
        linear-gradient(
          to top,
          color-mix(in srgb, var(--veil) 70%, transparent) 0%,
          color-mix(in srgb, var(--veil) 30%, transparent) 55%,
          color-mix(in srgb, var(--veil) 0%, transparent) 100%
        );
    }
  }

  /* Same container as the home page's two columns below (HomeShell), so the text starts where the posts start. */
  .content {
    width: 100%;
    max-width: calc(var(--container-wide) + 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--space-16) var(--gutter) var(--space-12);
    text-shadow: var(--text-shadow-image);
  }

  /* White label with a short gold rule: gold text itself would not stay readable over the brightest part of the sky. */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--on-image);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .eyebrow::before {
    content: '';
    width: var(--space-6);
    height: var(--border-thick);
    background: var(--sun);
  }

  h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-display);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-tight);
  }

  .tagline {
    max-width: 32rem;
    margin-top: var(--space-3);
    color: var(--on-image-muted);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }
</style>
