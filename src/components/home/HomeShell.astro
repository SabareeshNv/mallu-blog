---
/**
 * The home page's two columns: the writing (default slot) and its side column (slot "rail").
 * One column below 1024px, with the side column after the writing.
 */
import Container from '@/components/ui/Container.astro';
---

<Container size="wide">
  <div class="shell">
    <div class="main">
      <slot />
    </div>
    <slot name="rail" />
  </div>
</Container>

<style>
  .main {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) calc(var(--rail-width) + var(--space-8));
      gap: var(--space-8);
    }
  }
</style>
