---
import FormattedDate from './FormattedDate.astro';
import { excerpt, isEssay, postUrl, type Group } from '../lib/posts';
import { SITE } from '../site.config';

interface Props {
  group: Group<string>;
}

const { group } = Astro.props;
const headingId = `year-${group.key}`;
---

<section class="year" aria-labelledby={headingId}>
  <h2 id={headingId}>
    {group.label}
    <span class="count">{group.posts.length} {group.posts.length === 1 ? 'entry' : 'entries'}</span>
  </h2>
  <ol class="rows" role="list">
    {
      group.posts.map((post) => {
        const essay = isEssay(post);
        return (
          <li class="row">
            <FormattedDate class="date" date={post.data.date} format="short" />
            <span class:list={['kind', essay ? 'is-essay' : 'is-scribble']}>{essay ? 'Essay' : 'Scribble'}</span>
            <a class:list={['link', { 'is-excerpt': !essay }]} href={postUrl(post)} lang={SITE.postLang}>
              {essay ? post.data.title : excerpt(post, 70)}
            </a>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .year + .year {
    margin-top: var(--space-l);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    margin: 0 0 var(--space-s);
    padding-bottom: var(--space-xs);
    border-bottom: 2px solid var(--text);
    font-size: var(--step-2);
    font-weight: 800;
  }

  .count {
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 500;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem 5.5rem 1fr;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border);
  }

  .date {
    color: var(--muted);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .kind {
    justify-self: start;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .is-essay {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .is-scribble {
    background: var(--surface-strong);
    color: var(--muted);
  }

  .link {
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .link.is-excerpt {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    font-weight: 400;
    color: var(--muted);
  }

  .link:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  @media (max-width: 34rem) {
    .row {
      grid-template-columns: auto 1fr;
      gap: 0.2rem var(--space-xs);
    }

    .link {
      grid-column: 1 / -1;
    }
  }
</style>
