---
import SunIcon from '@/components/icons/SunIcon.astro';
import MoonIcon from '@/components/icons/MoonIcon.astro';
/**
 * Light / dark theme switch: one button that changes to the opposite of the theme currently shown.
 * Until the reader presses it, the page follows the device's setting (see scripts/theme-init.js and the script below).
 * Its icon is the theme a press will switch to (a moon in the light theme, a sun in the dark theme); aria-pressed is
 * true while the dark theme is showing. A native button, so Enter and Space work as well as a click or tap.
 */
---

<button
  type="button"
  class="toggle"
  aria-pressed="false"
  aria-label="Dark theme"
  title="Switch theme"
  data-theme-toggle
>
  <span class="icon icon-moon">
    <MoonIcon />
  </span>
  <span class="icon icon-sun">
    <SunIcon />
  </span>
</button>

<style>
  .toggle {
    display: inline-grid;
    place-items: center;
    width: var(--control-h);
    height: var(--control-h);
    margin: 0;
    padding: 0;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .toggle:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* The switch needs JavaScript; without it the device's setting is used. */
  :global(html:not([data-js])) .toggle {
    display: none;
  }

  .icon {
    display: grid;
    place-items: center;
  }

  .icon-sun,
  :global(html[data-theme='dark']) .icon-moon {
    display: none;
  }

  :global(html[data-theme='dark']) .icon-sun {
    display: grid;
  }
</style>

<script>
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  function stored(): Theme | null {
    try {
      const value = localStorage.getItem('theme');
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-pressed', String(theme === 'dark'));
    });
  }

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try {
        localStorage.setItem('theme', next);
      } catch {}
    });
  });

  // Follow the device's setting while the reader has not pressed the button.
  systemDark.addEventListener('change', (event) => {
    if (!stored()) apply(event.matches ? 'dark' : 'light');
  });
</script>
