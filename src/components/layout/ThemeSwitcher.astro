---
import SunIcon from '@/components/icons/SunIcon.astro';
import MoonIcon from '@/components/icons/MoonIcon.astro';
/**
 * Light / dark theme switcher (icons only; the labels are read by screen readers).
 * Two real buttons: each is reachable with Tab and works with Enter and Space. The current theme is
 * exposed to screen readers through aria-pressed.
 */
---

<div class="switcher" role="group" aria-label="Colour theme" data-theme-switcher>
  <button
    type="button"
    class="option"
    data-theme-value="light"
    aria-pressed="false"
    aria-label="Light theme"
    title="Light theme"
  >
    <SunIcon />
  </button>
  <button
    type="button"
    class="option"
    data-theme-value="dark"
    aria-pressed="false"
    aria-label="Dark theme"
    title="Dark theme"
  >
    <MoonIcon />
  </button>
</div>

<style>
  /* Track height equals --control-h: 4px padding + 32px options + 4px padding. */
  .switcher {
    display: inline-flex;
    gap: var(--space-1);
    margin: 0;
    padding: calc(var(--space-1) - var(--border-width));
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
  }

  /* The switcher needs JavaScript; without it the OS preference is used. */
  :global(html:not([data-js])) .switcher {
    display: none;
  }

  .option {
    display: inline-grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .option:hover {
    color: var(--text);
  }

  .option[aria-pressed='true'] {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .option:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--focus-offset);
  }
</style>

<script>
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  function stored(): Theme | null {
    try {
      const value = localStorage.getItem('theme');
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    document.querySelectorAll<HTMLButtonElement>('[data-theme-switcher] [data-theme-value]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeValue === theme));
    });
  }

  apply((root.dataset.theme as Theme) ?? 'light');

  // A native button fires "click" for Enter and Space as well as for the mouse and touch.
  document.querySelectorAll<HTMLElement>('[data-theme-switcher]').forEach((switcher) => {
    switcher.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-theme-value]');
      if (!button) return;
      const theme = button.dataset.themeValue as Theme;
      apply(theme);
      try {
        localStorage.setItem('theme', theme);
      } catch {}
    });
  });

  // Follow the OS while the reader has not made an explicit choice.
  systemDark.addEventListener('change', (event) => {
    if (!stored()) apply(event.matches ? 'dark' : 'light');
  });
</script>
