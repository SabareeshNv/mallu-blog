---
import { SITE } from '@/config/site';
import { FOOTER_NAV } from '@/config/navigation';

const year = new Date().getFullYear();
const path = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="inner">
    <nav class="start" aria-label="Footer">
      <ul class="links">
        {FOOTER_NAV.map((link) => (
          <li>
            <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="copy">
      © {year} {SITE.author}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --focus: #93c5fd;
    margin-top: var(--space-24);
    background: var(--ink);
    color: var(--on-ink-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  /* Small screens: the links on one row, spread evenly (equal margins and gaps), with the copyright centred beneath. */
  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-8) var(--gutter);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-evenly;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--on-ink);
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .copy {
    margin: 0;
    text-align: center;
  }

  /* From 480px: the links on the left, the copyright on the right. If the copyright still does not fit beside the
     links (a long name), it wraps onto its own line and a small script (below) centres it. */
  @media (min-width: 30rem) {
    .inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4) var(--space-8);
    }

    ul {
      justify-content: flex-start;
      gap: var(--space-2) var(--space-6);
    }

    .copy {
      flex: 1 1 auto;
      text-align: end;
    }

    .site-footer[data-wrapped] .copy {
      text-align: center;
    }
  }
</style>

<script>
  // Marks the footer when the copyright has wrapped below the links, so it can be centred there.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const start = footer?.querySelector<HTMLElement>('.start');
  const copy = footer?.querySelector<HTMLElement>('.copy');

  if (footer && start && copy) {
    const update = () => {
      const wrapped = copy.getBoundingClientRect().top >= start.getBoundingClientRect().bottom - 1;
      footer.toggleAttribute('data-wrapped', wrapped);
    };
    const observer = new ResizeObserver(update);
    [footer, start, copy].forEach((element) => observer.observe(element));
    update();
    // Web fonts change text widths when they arrive.
    document.fonts?.ready.then(update);
  }
</script>
