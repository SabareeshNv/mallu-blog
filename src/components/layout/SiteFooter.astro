---
import RssIcon from '@/components/icons/RssIcon.astro';
import { SITE } from '@/config/site';
import { ROUTES } from '@/config/routes';
import { EXPLORE_NAV, FOOTER_NAV } from '@/config/navigation';

const year = new Date().getFullYear();
const path = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="top">
    <div class="about">
      <a class="name" href={ROUTES.home}>
        {SITE.title}
      </a>
      <p class="tagline">{SITE.tagline}</p>
    </div>
    <nav aria-labelledby="browse-heading">
      <h2 id="browse-heading">Browse</h2>
      <ul class="browse">
        {EXPLORE_NAV.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="inner">
    <div class="start">
      <nav aria-label="Footer">
        <ul class="links">
          {FOOTER_NAV.map((link) => (
            <li>
              <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a class="feed" href={ROUTES.rss} type="application/rss+xml" aria-label="RSS feed" title="RSS feed">
        <RssIcon />
      </a>
    </div>
    <p class="copy">
      © {year} {SITE.author}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --focus: #93c5fd;
    margin-top: var(--space-24);
    background: linear-gradient(180deg, color-mix(in srgb, var(--ink) 86%, var(--accent)), var(--ink) 60%);
    box-shadow: inset 0 1px 0 color-mix(in srgb, white 10%, transparent);
    color: var(--on-ink-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  /* The upper part: who this is, and where to go. */
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8) var(--space-12);
    padding: var(--space-12) var(--gutter) var(--space-8);
  }

  .name {
    color: var(--on-ink);
    font-size: var(--fs-lead);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-lead);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .tagline {
    max-width: 28rem;
    margin: var(--space-2) 0 0;
  }

  h2 {
    margin: 0;
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .browse {
    margin-top: var(--space-3);
    gap: var(--space-1) var(--space-6);
  }

  .browse a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h);
    color: var(--on-ink);
    text-decoration: none;
  }

  .browse a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* Links on the left, copyright on the right. When the copyright no longer fits beside the links it wraps
     onto its own line below them, and a small script (below) centres it. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-8);
    padding: var(--space-8) var(--gutter);
    border-top: var(--border-width) solid rgb(255 255 255 / 0.12);
  }

  .start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--on-ink);
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .feed {
    display: inline-grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    border-radius: var(--radius-full);
    color: var(--on-ink);
    transition: background-color var(--duration-fast) var(--ease);
  }

  .feed:hover {
    background: rgb(255 255 255 / 0.1);
  }

  /* Right-aligned beside the links; it grows to fill the line, so on its own line it spans the full width. */
  .copy {
    flex: 1 1 auto;
    margin: 0;
    text-align: end;
  }

  .site-footer[data-wrapped] .copy {
    text-align: center;
  }
</style>

<script>
  // Marks the footer when the copyright has wrapped below the links, so it can be centred there.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const start = footer?.querySelector<HTMLElement>('.start');
  const copy = footer?.querySelector<HTMLElement>('.copy');

  if (footer && start && copy) {
    const update = () => {
      const wrapped = copy.getBoundingClientRect().top >= start.getBoundingClientRect().bottom - 1;
      footer.toggleAttribute('data-wrapped', wrapped);
    };
    const observer = new ResizeObserver(update);
    [footer, start, copy].forEach((element) => observer.observe(element));
    update();
    // Web fonts change text widths when they arrive.
    document.fonts?.ready.then(update);
  }
</script>
