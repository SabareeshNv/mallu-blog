---
import { SITE } from '@/config/site';
import { FOOTER_NAV } from '@/config/navigation';

const year = new Date().getFullYear();
const path = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="inner">
    <nav aria-label="Footer">
      <ul class="links">
        {FOOTER_NAV.map((link) => (
          <li>
            <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="copy">
      © {year} {SITE.author}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --focus: #93c5fd;
    margin-top: var(--space-24);
    background: var(--ink);
    color: var(--on-ink-muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  /* Small screens: two rows. The links are spread evenly (equal margins and gaps), and the copyright is centred below. */
  .inner {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8) var(--gutter);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-evenly;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--on-ink);
    text-decoration: none;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .copy {
    margin: 0;
    text-align: center;
  }

  /* From 480px: side by side, the links on the left and the copyright on the right. */
  @media (min-width: 30rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--space-8);
    }

    ul {
      justify-content: flex-start;
      gap: var(--space-2) var(--space-6);
    }

    .copy {
      text-align: end;
    }
  }
</style>
