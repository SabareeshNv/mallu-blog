---
import ThemeSwitcher from '@/components/layout/ThemeSwitcher.astro';
import LogoMark from '@/components/icons/LogoMark.astro';
import MenuIcon from '@/components/icons/MenuIcon.astro';
import SearchIcon from '@/components/icons/SearchIcon.astro';
import CloseIcon from '@/components/icons/CloseIcon.astro';
import { SITE } from '@/config/site';
import { ROUTES } from '@/config/routes';
import { MAIN_NAV, isActiveNavItem } from '@/config/navigation';

const links = MAIN_NAV.map((item) => ({ ...item, active: isActiveNavItem(item, Astro.url.pathname) }));
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={ROUTES.home} aria-label={`${SITE.title} — home`}>
      <LogoMark />
      <span class="name">{SITE.title}</span>
    </a>
    <!-- Two copies of the theme switch, so the keyboard order matches what is on screen at each size:
         phones: logo, theme, menu button, menu links; larger screens: logo, links, theme. Only one is ever shown. -->
    <div class="theme theme-phone">
      <ThemeSwitcher />
    </div>
    <button
      type="button"
      class="toggle"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="Open menu"
      data-menu-toggle
    >
      <span class="icon icon-open">
        <MenuIcon />
      </span>
      <span class="icon icon-close">
        <CloseIcon />
      </span>
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.active ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button type="button" class="search-open" data-search-open aria-label="Search" aria-keyshortcuts="Control+K Meta+K">
      <SearchIcon />
      <span class="search-label">Search</span>
    </button>
    <div class="theme theme-desktop">
      <ThemeSwitcher />
    </div>
  </div>
</header>

<style>
  /* The header sits on the page itself: the page background, one hairline beneath, and nothing else. */
  .site-header {
    --bar-h: var(--space-16);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    box-shadow: 0 var(--border-width) 0 var(--border);
    transition: background-color var(--duration) var(--ease);
  }

  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    grid-template-areas: 'brand nav search switcher';
    align-items: center;
    column-gap: var(--space-6);
    min-height: var(--bar-h);
    padding-inline: var(--gutter);
  }

  /* justify-self keeps the link as wide as the logo and name; the free space beside it is not clickable. */
  .brand {
    grid-area: brand;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: var(--space-12);
    gap: var(--space-3);
    color: var(--text);
    font-size: var(--fs-lead);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-lead);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .search-open {
    grid-area: search;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--control-h);
    margin-inline: var(--space-2);
    padding: 0 var(--space-3);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: var(--fs-small);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .search-open:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* Search needs JavaScript, and on small screens it moves above the posts (the header has no room). */
  :global(html:not([data-js])) .search-open {
    display: none;
  }

  /* The word "Search" only where there is room; on mid-size screens just the icon. */
  @media (max-width: 64rem) {
    .search-label {
      display: none;
    }

    .search-open {
      width: var(--control-h);
      justify-content: center;
      padding: 0;
    }
  }

  nav {
    grid-area: nav;
    justify-self: end;
    align-self: stretch;
  }

  .theme {
    grid-area: switcher;
    display: flex;
    align-items: center;
  }

  .theme-phone {
    display: none;
  }

  ul {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Plain text links. The current page is marked with a bar that sits on the header's bottom line.
     Hovering or focusing any other link turns it teal and brings up a small dot beneath the label. */
  nav a {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding-inline: var(--space-4);
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }

  nav a::before {
    content: '';
    position: absolute;
    inset-inline-start: 50%;
    bottom: var(--space-3);
    width: var(--space-1);
    height: var(--space-1);
    margin-inline-start: calc(-0.5 * var(--space-1));
    border-radius: var(--radius-full);
    background: var(--accent);
    transform: scale(0);
    transition: transform var(--duration-fast) var(--ease);
  }

  nav a::after {
    content: '';
    position: absolute;
    inset-inline: var(--space-4);
    bottom: calc(-1 * var(--border-width));
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--accent);
  }

  nav a:hover::before,
  nav a:focus-visible::before {
    transform: scale(1);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: var(--fw-bold);
  }

  nav a[aria-current='page']::before {
    transform: scale(0);
  }

  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  nav a:focus-visible {
    outline-offset: calc(-1 * var(--space-2));
  }

  /* The menu button only exists on phones, and only when JavaScript can open it. */
  .toggle {
    display: none;
  }

  /* ---------- Phones ---------- */
  /* Six links need a little less space each on mid-size screens. */
  @media (max-width: 64rem) {
    nav a {
      padding-inline: var(--space-3);
    }

    nav a::after {
      inset-inline: var(--space-3);
    }
  }

  @media (max-width: 48rem) {
    .search-open {
      display: none !important;
    }

    .theme-desktop {
      display: none;
    }

    .theme-phone {
      display: flex;
    }

    /* Without JavaScript the menu cannot open, so the links stay visible on a row of their own. */
    :global(html:not([data-js])) .site-header {
      position: relative;
    }

    :global(html:not([data-js])) .inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand switcher'
        'nav nav';
      row-gap: 0;
    }

    :global(html:not([data-js])) .brand {
      height: var(--space-16);
    }

    :global(html:not([data-js])) nav {
      justify-self: stretch;
      height: var(--space-12);
      margin-inline: calc(-1 * var(--space-4));
      border-top: var(--border-width) solid var(--border);
      padding-inline: var(--space-1);
    }

    :global(html:not([data-js])) ul {
      justify-content: space-between;
      gap: var(--space-2);
    }

    :global(html:not([data-js])) nav a {
      padding-inline: var(--space-3);
    }

    :global(html:not([data-js])) nav a::after {
      inset-inline: var(--space-3);
    }

    /* With JavaScript: one row (logo, theme switch, menu button) and a list that drops down beneath it. */
    :global(html[data-js]) .inner {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'brand switcher toggle';
      column-gap: var(--space-3);
    }

    :global(html[data-js]) .toggle {
      grid-area: toggle;
      display: inline-grid;
      place-items: center;
      width: var(--control-h);
      height: var(--control-h);
      margin: 0;
      padding: 0;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-full);
      background: transparent;
      color: var(--text);
      font: inherit;
      cursor: pointer;
      transition: background-color var(--duration-fast) var(--ease);
    }

    :global(html[data-js]) .toggle:hover,
    :global(html[data-js]) .toggle[aria-expanded='true'] {
      background: var(--accent-soft);
      color: var(--accent);
    }

    .icon {
      display: grid;
      place-items: center;
    }

    .icon-close,
    .toggle[aria-expanded='true'] .icon-open {
      display: none;
    }

    .toggle[aria-expanded='true'] .icon-close {
      display: grid;
    }

    :global(html[data-js]) nav {
      position: absolute;
      inset: 100% 0 auto;
      justify-self: stretch;
      align-self: auto;
      height: auto;
      padding-block: var(--space-2);
      background: var(--bg);
      border-bottom: var(--border-width) solid var(--border);
      box-shadow: var(--shadow-md);
      visibility: hidden;
      opacity: 0;
      transform: translateY(calc(-1 * var(--space-2)));
      transition:
        opacity var(--duration-fast) var(--ease),
        transform var(--duration-fast) var(--ease),
        visibility 0s linear var(--duration-fast);
    }

    :global(html[data-js]) .site-header.is-open nav {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }

    :global(html[data-js]) ul {
      flex-direction: column;
      height: auto;
    }

    :global(html[data-js]) li + li {
      border-top: var(--border-width) solid var(--border);
    }

    /* Each row is a full-width, 48px-tall touch target; the current page is marked by a bar on the left edge. */
    :global(html[data-js]) nav a {
      height: var(--space-12);
      padding-inline: var(--gutter);
      font-size: var(--fs-body);
      line-height: var(--lh-body);
    }

    :global(html[data-js]) nav a {
      transition:
        background-color var(--duration-fast) var(--ease),
        color var(--duration-fast) var(--ease);
    }

    :global(html[data-js]) nav a::before {
      display: none;
    }

    :global(html[data-js]) nav a::after {
      inset: var(--space-2) auto var(--space-2) 0;
      width: 3px;
      height: auto;
      transform: none;
      opacity: 0;
    }

    :global(html[data-js]) nav a[aria-current='page']::after {
      opacity: 1;
    }

    /* Hover, keyboard focus and the moment of a touch: a soft tint and a teal label. */
    :global(html[data-js]) nav a:hover,
    :global(html[data-js]) nav a:focus-visible,
    :global(html[data-js]) nav a:active {
      background: var(--accent-soft);
      color: var(--accent);
    }

    :global(html[data-js]) nav a:focus-visible {
      outline-offset: calc(-1 * var(--space-1));
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  if (header && toggle) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    function setOpen(open: boolean, returnFocus = false) {
      header!.classList.toggle('is-open', open);
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (!open && returnFocus) toggle!.focus();
    }

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Escape closes the menu and returns focus to its button.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false, header.contains(document.activeElement));
    });

    // A tap outside the header closes it, and so does tabbing out of it.
    document.addEventListener('click', (event) => {
      if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
    });
    header.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (isOpen() && next && !header.contains(next)) setOpen(false);
    });

    // Growing past the phone breakpoint shows the regular navigation, so reset the menu.
    matchMedia('(min-width: 48.0625rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
