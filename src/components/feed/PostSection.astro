---
/**
 * A titled list of posts at the end of a page ("Keep reading", "More scribbles"). Renders nothing when empty.
 */
import PostList from '@/components/feed/PostList.astro';
import type { Post } from '@/lib/content';

interface Props {
  heading: string;
  posts: Post[];
  dateFormat?: 'short' | 'medium';
}

const { heading, posts, dateFormat = 'medium' } = Astro.props;
const id = `section-${heading.toLowerCase().replace(/\W+/g, '-')}`;
---

{posts.length > 0 && (
  <section class="section" aria-labelledby={id}>
    <h2 id={id}>{heading}</h2>
    <PostList posts={posts} dateFormat={dateFormat} />
  </section>
)}

<style>
  /* An edge-to-edge tonal band that runs down to the footer. The footer's top margin (--space-24) is cancelled by the
     band's own negative bottom margin and paid back as padding, so the two touch. */
  .section {
    position: relative;
    margin: var(--space-16) 0 calc(-1 * var(--space-24));
    padding: var(--space-12) 0 calc(var(--space-12) + var(--space-24));
    background: var(--surface);
    box-shadow: 0 0 0 100vmax var(--surface);
    clip-path: inset(0 -100vmax);
    font-family: var(--font-sans);
  }

  /* Its top edge is a soft wave: the page colour hangs down over the band's upper edge. */
  .section::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100vmax;
    width: calc(100% + 200vmax);
    height: var(--wave-height);
    background: var(--bg);
    mask: var(--wave-foot) repeat-x 0 0 / var(--wave-length) var(--wave-height);
  }

  h2 {
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thick) solid var(--accent);
    font-size: var(--fs-h3);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-h3);
  }
</style>
