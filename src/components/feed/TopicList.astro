---
/**
 * Every topic with how many entries it has: one plain row each, the whole row a link.
 */
import { topicUrl, type Topic } from '@/lib/content';
import { countOf } from '@/lib/format';
import { SITE } from '@/config/site';

interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;
---

<ul class="topics" role="list">
  {topics.map((topic) => (
    <li>
      <a href={topicUrl(topic)}>
        <span class="name" lang={SITE.postLang}>
          {topic.name}
        </span>
        <span class="count">{countOf(topic.posts.length, 'entry', 'entries')}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .topics {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--accent);
  }

  a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--border-width) solid var(--border);
    color: var(--text);
    text-decoration: none;
  }

  .name {
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: var(--lh-h3);
  }

  .count {
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  a:hover .name {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
