---
interface Props {
  current: number;
  last: number;
  prevUrl?: string;
  nextUrl?: string;
  /** Labels for the two directions. */
  prevLabel?: string;
  nextLabel?: string;
}

const { current, last, prevUrl, nextUrl, prevLabel = 'Newer', nextLabel = 'Older' } = Astro.props;
---

{last > 1 && (
  <nav class="pagination" aria-label="Pagination">
    {prevUrl ? (
      <a href={prevUrl} rel="prev">
        <span aria-hidden="true">←</span> {prevLabel}
      </a>
    ) : (
      <span />
    )}
    <span class="status" aria-current="page">
      Page {current} of {last}
    </span>
    {nextUrl ? (
      <a href={nextUrl} rel="next">
        {nextLabel} <span aria-hidden="true">→</span>
      </a>
    ) : (
      <span />
    )}
  </nav>
)}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--border-width) solid var(--border);
  }

  /* Shared button style: 40px tall pill, 1px border, bold small text. */
  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    height: var(--control-h);
    padding: 0 var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  a[rel='next'] {
    justify-self: end;
  }

  a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .status {
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }
</style>
