---
import PostList from '@/components/feed/PostList.astro';
import { countOf } from '@/lib/format';
import type { Group } from '@/lib/content';

interface Props {
  group: Group;
}

const { group } = Astro.props;
const headingId = `year-${group.key}`;
---

<section class="year" aria-labelledby={headingId}>
  <h2 id={headingId}>
    {group.label}
    <span class="count">{countOf(group.posts.length, 'entry', 'entries')}</span>
  </h2>
  <PostList posts={group.posts} />
</section>

<style>
  .year + .year {
    margin-top: var(--space-12);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 2px solid var(--accent);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-h2);
  }

  .count {
    color: var(--muted);
    font-size: var(--fs-meta);
    font-weight: var(--fw-regular);
    line-height: var(--lh-meta);
  }
</style>
