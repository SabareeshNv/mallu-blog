---
/**
 * The Essays page: essays grouped by year, two across, so a reader can scan them all at once.
 */
import type { Page } from 'astro';
import Container from '@/components/ui/Container.astro';
import SearchBar from '@/components/search/SearchBar.astro';
import EssayEntry from '@/components/feed/EssayEntry.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Pagination from '@/components/feed/Pagination.astro';
import { groupByYear, type Post } from '@/lib/content';

interface Props {
  page: Page<Post>;
  title: string;
  intro?: string;
  emptyText?: string;
}

const { page, title, intro, emptyText = 'No essays have been published yet.' } = Astro.props;
const groups = groupByYear(page.data);
const pageNote = page.lastPage > 1 ? `Page ${page.currentPage} of ${page.lastPage}.` : '';
const lead = [intro, pageNote].filter(Boolean).join(' ');
---

<Container size="feed">
  <PageHeader title={title} intro={lead} />
  <SearchBar />

  {groups.length === 0 && <p class="empty">{emptyText}</p>}
  {groups.map((group) => (
    <section class="year" aria-labelledby={`year-${group.key}`}>
      <h2 id={`year-${group.key}`}>{group.label}</h2>
      <ol class="grid" role="list">
        {group.posts.map((post) => (
          <li>
            <EssayEntry post={post} variant="grid" />
          </li>
        ))}
      </ol>
    </section>
  ))}

  <Pagination current={page.currentPage} last={page.lastPage} prevUrl={page.url.prev} nextUrl={page.url.next} />
</Container>

<style>
  .empty {
    color: var(--muted);
  }

  .year + .year {
    margin-top: var(--space-16);
  }

  h2 {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thick) solid var(--accent);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-h2);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-10) var(--space-6);
    }
  }
</style>
