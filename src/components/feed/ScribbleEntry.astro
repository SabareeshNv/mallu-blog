---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import FormattedDate from '@/components/ui/FormattedDate.astro';
import PermalinkIcon from '@/components/icons/PermalinkIcon.astro';
import Prose from '@/components/ui/Prose.astro';
import { postAnchor, postUrl, type Post } from '@/lib/content';
import { formatDate } from '@/lib/format';

interface Props {
  post: Post;
  /** "feed" in lists; "page" when a scribble has a page of its own: larger text, with the date above it. */
  variant?: 'feed' | 'page';
}

const { post, variant = 'feed' } = Astro.props;
const { date, cover, coverAlt } = post.data;
const { Content } = await render(post);
const anchor = postAnchor(post);
const longDate = formatDate(date);
---

<article
  class:list={['scribble', variant]}
  id={anchor}
  tabindex="-1"
  aria-label={`Scribble from ${longDate}`}
  data-scribble
>
  {variant === 'page' && (
    <p class="when" data-pagefind-ignore>
      <span class="kind">Scribble</span>
      <span aria-hidden="true">·</span>
      <FormattedDate date={date} />
    </p>
  )}
  {cover && (
    <Image
      class="cover"
      src={cover}
      alt={coverAlt ?? ''}
      widths={[320, 480, 720, 1080]}
      sizes="(min-width: 48rem) 16rem, 100vw"
      data-fade
    />
  )}
  <Prose size={variant === 'page' ? 'xl' : 'regular'}>
    <Content />
  </Prose>
  {variant === 'feed' && (
    <footer class="meta">
      <span class="kind">Scribble</span>
      <span aria-hidden="true">·</span>
      <FormattedDate date={date} />
      <span aria-hidden="true">·</span>
      <a class="permalink" href={postUrl(post)} aria-label={`Permalink to scribble from ${longDate}`} title="Permalink">
        <PermalinkIcon />
      </a>
    </footer>
  )}
</article>

<style>
  /* A scribble is plain text on the page: no frame, no fill. Only its words, a date and a permalink. */
  .scribble {
    position: relative;
    outline: none;
  }

  .scribble:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: var(--space-2);
  }

  /* Arriving at a scribble through "See it in the stream" (a #scribble-… address): the browser scrolls to it and focuses
     it, and :target marks the text like a highlighter, then fades. No script is needed. */
  .scribble:target {
    background: var(--highlight);
    box-shadow: 0 0 0 var(--space-2) var(--highlight);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scribble:target {
      animation: arrive 2000ms var(--ease) forwards;
    }

    @keyframes arrive {
      to {
        background-color: transparent;
        box-shadow: 0 0 0 var(--space-2) transparent;
      }
    }
  }

  /* A scribble's photograph is a small snapshot beside the words, not a banner. */
  .cover {
    width: 100%;
    aspect-ratio: var(--ratio-photo);
    margin: 0 0 var(--space-4);
    background: var(--surface-strong);
    object-fit: cover;
  }

  @media (min-width: 40rem) {
    .cover {
      float: inline-end;
      width: 40%;
      margin: var(--space-1) 0 var(--space-2) var(--space-6);
    }
  }

  /* On its own page the date leads, larger, above the text. */
  .when {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .meta {
    clear: both;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .kind {
    color: var(--accent);
    font-weight: var(--fw-bold);
  }

  .permalink {
    display: inline-grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    margin-block: calc(-1 * var(--space-1));
    border-radius: var(--radius-full);
    color: var(--muted);
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .permalink:hover {
    color: var(--accent);
    background: var(--surface-strong);
  }
</style>
