---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import FormattedDate from '@/components/ui/FormattedDate.astro';
import PermalinkIcon from '@/components/icons/PermalinkIcon.astro';
import Prose from '@/components/ui/Prose.astro';
import { postAnchor, postUrl, type Post } from '@/lib/content';
import { formatDate } from '@/lib/format';

interface Props {
  post: Post;
  /** "large" is used when a scribble has a page of its own. */
  size?: 'regular' | 'large';
}

const { post, size = 'regular' } = Astro.props;
const { date, cover, coverAlt } = post.data;
const { Content } = await render(post);
const anchor = postAnchor(post);
const longDate = formatDate(date);
---

<article class="scribble" id={anchor} tabindex="-1" aria-label={`Scribble from ${longDate}`} data-scribble>
  {cover && (
    <Image
      class="cover"
      src={cover}
      alt={coverAlt ?? ''}
      widths={[320, 480, 720, 1080]}
      sizes="(min-width: 48rem) 16rem, 100vw"
      data-fade
    />
  )}
  <Prose size={size}>
    <Content />
  </Prose>
  <footer class="meta">
    <span class="kind">Scribble</span>
    <span aria-hidden="true">·</span>
    <FormattedDate date={date} />
    <span aria-hidden="true">·</span>
    <a
      class="permalink"
      href={postUrl(post)}
      data-scribble-permalink={anchor}
      aria-label={`Permalink to scribble from ${longDate}`}
      title="Permalink"
    >
      <PermalinkIcon />
    </a>
  </footer>
</article>

<style>
  /* A scribble is plain text on the page: no frame, no fill. Only its words, a date and a permalink. */
  .scribble {
    position: relative;
    outline: none;
  }

  .scribble:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: var(--space-2);
  }

  /* Reaching a scribble through its permalink marks the text like a highlighter, then fades. */
  .scribble:target,
  .scribble.is-highlighted {
    background: var(--highlight);
    box-shadow: 0 0 0 var(--space-2) var(--highlight);
  }

  @media (prefers-reduced-motion: no-preference) {
    .scribble:target,
    .scribble.is-highlighted {
      animation: arrive 2000ms var(--ease) forwards;
    }

    @keyframes arrive {
      to {
        background-color: transparent;
        box-shadow: 0 0 0 var(--space-2) transparent;
      }
    }
  }

  /* A scribble's photograph is a small snapshot beside the words, not a banner. */
  .cover {
    float: inline-end;
    width: 40%;
    aspect-ratio: 3 / 2;
    margin: var(--space-1) 0 var(--space-2) var(--space-6);
    background: var(--surface-strong);
    object-fit: cover;
  }

  @media (max-width: 40rem) {
    .cover {
      float: none;
      width: 100%;
      aspect-ratio: 3 / 2;
      margin: 0 0 var(--space-4);
    }
  }

  .meta {
    clear: both;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .kind {
    color: var(--accent);
    font-weight: var(--fw-bold);
  }

  .permalink {
    display: inline-grid;
    place-items: center;
    width: var(--icon-button);
    height: var(--icon-button);
    margin-block: calc(-1 * var(--space-1));
    border-radius: var(--radius-full);
    color: var(--muted);
    transition:
      background-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .permalink:hover {
    color: var(--accent);
    background: var(--surface-strong);
  }
</style>

<script>
  // Clicking a scribble's permalink inside a list scrolls to it (and focuses it)
  // instead of leaving the page. Opening it in a new tab still goes to its own URL.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  function reveal(target: HTMLElement, smooth: boolean) {
    target.scrollIntoView({ behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto', block: 'start' });
    target.focus({ preventScroll: true });
    target.classList.remove('is-highlighted');
    void target.offsetWidth; // restart the highlight animation
    target.classList.add('is-highlighted');
  }

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-scribble-permalink]');
    if (!link) return;
    const target = document.getElementById(link.dataset.scribblePermalink!);
    if (!target) return;
    event.preventDefault();
    history.pushState(null, '', `#${target.id}`);
    reveal(target, true);
  });

  // Arriving with a #scribble-… hash (e.g. from "View in stream"): focus and highlight it.
  function fromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    if (target?.matches('[data-scribble]')) reveal(target, false);
  }

  fromHash();
  window.addEventListener('popstate', fromHash);
</script>
