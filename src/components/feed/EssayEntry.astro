---
import { Image } from 'astro:assets';
import FormattedDate from '@/components/ui/FormattedDate.astro';
import { postSummary, postAnchor, postUrl, readingMinutes, type Post } from '@/lib/content';
import { SITE } from '@/config/site';

interface Props {
  post: Post;
  /**
   * "timeline" is the entry in the month timeline; "featured" is the large latest-essay block on the home page;
   * "grid" is the compact entry on the Essays page.
   */
  variant?: 'timeline' | 'featured' | 'grid';
}

const { post, variant = 'timeline' } = Astro.props;
const excerptLength = { timeline: 90, featured: 220, grid: 70 }[variant];
const coverSizes = {
  timeline: '(min-width: 48rem) 43rem, 100vw',
  featured: '(min-width: 48rem) 43rem, 100vw',
  grid: '(min-width: 48rem) 22rem, 100vw',
}[variant];
const { title, date, cover, coverAlt } = post.data;
const url = postUrl(post);
const minutes = readingMinutes(post);
---

<article class:list={['essay', variant, { 'has-cover': cover }]} id={postAnchor(post)}>
  {cover ? (
    <div class="cover">
      <Image src={cover} alt={coverAlt ?? ''} widths={[480, 720, 1080, 1400]} sizes={coverSizes} data-fade />
      <h3 class="title" lang={SITE.postLang}>
        <a href={url}>{title}</a>
      </h3>
    </div>
  ) : (
    <h3 class="title" lang={SITE.postLang}>
      <a href={url}>{title}</a>
    </h3>
  )}
  <p class="summary" lang={SITE.postLang}>
    {postSummary(post, excerptLength)}
  </p>
  <p class="meta">
    <span class="kind">Essay</span>
    <span aria-hidden="true">·</span>
    <FormattedDate date={date} />
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
  </p>
  {variant === 'featured' && (
    <p class="more">
      <a href={url} aria-label={`Read the essay: ${title}`}>
        Read the essay{' '}
        <span class="arrow" aria-hidden="true">
          →
        </span>
      </a>
    </p>
  )}
</article>

<style>
  /* An essay is a headline: no frame, no fill. Scale and the photograph carry it. */
  .essay {
    position: relative;
  }

  .title {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    line-height: var(--lh-h2);
  }

  .title a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--essay) 45%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
    text-decoration-skip-ink: none;
    transition: text-decoration-color var(--duration-fast) var(--ease);
  }

  /* Stretch the link over the whole entry for a generous click target. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .essay:hover .title a {
    text-decoration-color: var(--essay);
  }

  .title a:focus-visible {
    outline: none;
  }

  .essay:has(.title a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: var(--space-2);
  }

  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    margin-top: var(--space-3);
    color: var(--muted);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .kind {
    color: var(--essay);
    font-weight: var(--fw-bold);
  }

  /* ---------- With a photograph: a plain, square picture with the title set across its foot ---------- */
  .cover {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    aspect-ratio: 2 / 1;
    margin-bottom: var(--space-4);
    overflow: hidden;
    background: var(--surface-strong);
    box-shadow: var(--depth-1);
  }

  .cover :global(img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--veil) 88%, transparent) 0%,
      color-mix(in srgb, var(--veil) 50%, transparent) 38%,
      color-mix(in srgb, var(--veil) 0%, transparent) 72%
    );
  }

  .has-cover .title {
    padding: var(--space-16) var(--space-6) var(--space-5);
    text-shadow: var(--text-shadow-image);
  }

  /* On a photograph the title carries no underline; hover and focus turn it gold instead. */
  .has-cover .title a {
    color: var(--on-image);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease);
  }

  .essay.has-cover:hover .title a,
  .essay.has-cover:has(.title a:focus-visible) .title a {
    color: var(--sun);
  }

  /* ---------- Featured: the latest essay, set larger at the top of the home page ---------- */
  .featured .cover {
    aspect-ratio: 16 / 9;
  }

  .featured .title {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
  }

  .featured.has-cover .title {
    padding: var(--space-24) var(--space-8) var(--space-6);
  }

  .featured .summary {
    -webkit-line-clamp: 4;
    line-clamp: 4;
    margin-top: var(--space-4);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }

  .more {
    margin-top: var(--space-4);
    color: var(--essay);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
  }

  /* A real link that looks exactly as the plain text did; it sits above the card's stretched title link. */
  .more a {
    position: relative;
    z-index: 1;
    color: inherit;
    text-decoration: none;
  }

  .arrow {
    display: inline-block;
    transition: transform var(--duration-fast) var(--ease);
  }

  .essay:hover .arrow {
    transform: translateX(var(--space-1));
  }

  /* ---------- Grid: compact entries, two across, on the Essays page ---------- */
  .grid .cover {
    aspect-ratio: 3 / 2;
  }

  .grid .title {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }

  .grid.has-cover .title {
    padding: var(--space-12) var(--space-4) var(--space-4);
  }

  .grid .summary {
    -webkit-line-clamp: 3;
    line-clamp: 3;
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  @media (max-width: 40rem) {
    .cover,
    .featured .cover,
    .grid .cover {
      aspect-ratio: 4 / 3;
    }

    .has-cover .title,
    .grid.has-cover .title {
      padding: var(--space-12) var(--space-4) var(--space-4);
    }

    .featured.has-cover .title {
      padding: var(--space-16) var(--space-4) var(--space-4);
    }

    .featured .title {
      font-size: var(--fs-h2);
      line-height: var(--lh-h2);
    }
  }
</style>
