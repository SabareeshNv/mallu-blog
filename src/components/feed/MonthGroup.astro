---
import EssayEntry from '@/components/feed/EssayEntry.astro';
import ScribbleEntry from '@/components/feed/ScribbleEntry.astro';
import EssayIcon from '@/components/icons/EssayIcon.astro';
import ScribbleIcon from '@/components/icons/ScribbleIcon.astro';
import { isEssay, type Group } from '@/lib/content';
import { formatMonthName } from '@/lib/format';

interface Props {
  group: Group;
}

const { group } = Astro.props;
const headingId = `month-${group.key}`;
const [year] = group.key.split('-');
const monthName = formatMonthName(group.posts[0].data.date);
---

<section class="month" aria-labelledby={headingId}>
  <h2 id={headingId} class="heading">
    {monthName} <span class="year">{year}</span>
  </h2>
  <ol class="timeline" role="list">
    {group.posts.map((post) => {
      const essay = isEssay(post);
      return (
        <li class:list={['item', essay ? 'is-essay' : 'is-scribble']}>
          <span class="node" aria-hidden="true">
            {essay ? <EssayIcon size={16} /> : <ScribbleIcon size={16} />}
          </span>
          {essay ? <EssayEntry post={post} /> : <ScribbleEntry post={post} />}
        </li>
      );
    })}
  </ol>
</section>

<style>
  .month + .month {
    margin-top: var(--space-16);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-h2);
    letter-spacing: -0.02em;
  }

  .year {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--accent) linear-gradient(180deg, color-mix(in srgb, white 22%, transparent), transparent);
    box-shadow:
      var(--depth-1),
      inset 0 1px 0 color-mix(in srgb, white 28%, transparent);
    color: var(--bg);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
  }

  /* A quiet vertical rail links the month's entries. Node: 32px; offset: 48px (40px on phones). */
  .timeline {
    --node: var(--space-8);
    --offset: var(--space-12);
    position: relative;
    display: grid;
    gap: var(--space-12);
    margin: 0;
    padding: 0 0 0 var(--offset);
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: var(--space-4);
    bottom: var(--space-4);
    left: calc(var(--node) / 2 - 1px);
    width: 2px;
    background: var(--rail);
  }

  .item {
    position: relative;
  }

  /* Sits level with the first line of each entry. */
  .node {
    position: absolute;
    top: 0;
    left: calc(-1 * var(--offset));
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 2px solid currentColor;
    border-radius: var(--radius-full);
    background: var(--bg);
    box-shadow:
      0 0 0 var(--space-1) var(--bg),
      var(--depth-1);
  }

  .node :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
  }

  .is-essay .node {
    color: var(--essay);
    background: var(--essay-soft);
  }

  .is-scribble .node {
    color: var(--accent);
    background: var(--accent-soft);
  }

  /* An essay's headline is taller than a line of text, so its node drops to meet the first line. */
  .is-essay:not(:has(.has-cover)) .node {
    top: var(--space-2);
  }

  /* The scribble reached through a permalink is marked on the timeline too. */
  .item:has(:target) .node {
    box-shadow: 0 0 0 var(--space-1) var(--highlight);
  }

  @media (max-width: 40rem) {
    .timeline {
      --offset: var(--space-10);
    }
  }
</style>
