---
import EssayEntry from '@/components/feed/EssayEntry.astro';
import ScribbleEntry from '@/components/feed/ScribbleEntry.astro';
import KindMark from '@/components/feed/KindMark.astro';
import { isEssay, type Group } from '@/lib/content';
import { formatMonthName } from '@/lib/format';

interface Props {
  group: Group;
}

const { group } = Astro.props;
const headingId = `month-${group.key}`;
const [year] = group.key.split('-');
const monthName = formatMonthName(group.posts[0].data.date);
---

<section class="month" aria-labelledby={headingId}>
  <h2 id={headingId} class="heading">
    {monthName} <span class="year">{year}</span>
  </h2>
  <ol class="timeline" role="list">
    {group.posts.map((post) => {
      const essay = isEssay(post);
      return (
        <li class:list={['item', essay ? 'is-essay' : 'is-scribble', { 'has-cover': post.data.cover }]}>
          <span class="node">
            <KindMark kind={essay ? 'essay' : 'scribble'} />
          </span>
          {essay ? <EssayEntry post={post} /> : <ScribbleEntry post={post} />}
        </li>
      );
    })}
  </ol>
</section>

<style>
  .month + .month {
    margin-top: var(--space-16);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-h2);
    letter-spacing: var(--tracking-tight);
  }

  .year {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
  }

  /* The thread: one line runs down the month, drawn item by item so that it can change with the kind of entry. A
     scribble is a note on a thin teal line with a small outlined mark; an essay is a landmark on a thick orange line
     with a large solid mark, and gets more space after it. Marks are centred on the line (--axis). */
  .timeline {
    --axis: var(--space-2);
    --offset: var(--space-10);
    margin: 0;
    padding: 0 0 0 var(--offset);
    list-style: none;
  }

  .item {
    position: relative;
    padding-bottom: var(--space-8);
  }

  .item:last-child {
    padding-bottom: 0;
  }

  .item::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--axis) - var(--offset) - var(--border-thick) / 2);
    width: var(--border-thick);
    background: var(--rail);
  }

  .is-essay {
    padding-bottom: var(--space-16);
  }

  .is-essay:last-child {
    padding-bottom: 0;
  }

  .is-essay::before {
    left: calc(var(--axis) - var(--offset) - var(--thread-heavy) / 2);
    width: var(--thread-heavy);
    background: var(--rail-essay);
  }

  .node {
    position: absolute;
    top: 0;
    left: calc(var(--axis) - var(--offset));
    translate: -50% 0;
  }

  /* An essay without a photograph starts with a headline taller than a line of text, so its mark drops to meet it. */
  .is-essay:not(.has-cover) .node {
    top: var(--space-2);
  }

  /* The scribble reached through a permalink is marked on the timeline too. */
  .item:has(:target) .node {
    filter: drop-shadow(0 0 var(--space-1) var(--highlight));
  }

  @media (min-width: 40rem) {
    .timeline {
      --axis: var(--space-4);
      --offset: var(--space-12);
    }
  }
</style>
