---
/**
 * A paginated stream of entries grouped by month, used by Home, Essays and Scribbles.
 */
import type { Page } from 'astro';
import Container from '@/components/ui/Container.astro';
import SearchBar from '@/components/search/SearchBar.astro';
import MonthGroup from '@/components/feed/MonthGroup.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Pagination from '@/components/feed/Pagination.astro';
import { groupByMonth, type Post } from '@/lib/content';

interface Props {
  page: Page<Post>;
  /** Visible page title. When omitted, a hidden heading is used (the hero provides the visible one). */
  title?: string;
  /** Language of the title when it is not English (for example a topic name). */
  titleLang?: string;
  intro?: string;
  emptyText?: string;
  /** Render without the page-width wrapper, when the feed sits inside another column (the home page). */
  flush?: boolean;
}

const { page, title, titleLang, intro, emptyText = 'Nothing here yet.', flush = false } = Astro.props;
const groups = groupByMonth(page.data);
const pageNote = page.lastPage > 1 ? `Page ${page.currentPage} of ${page.lastPage}.` : '';
const lead = [intro, pageNote].filter(Boolean).join(' ');
---

<Container size={flush ? 'flush' : 'feed'}>
  {title ? <PageHeader title={title} intro={lead} lang={titleLang} /> : <h2 class="sr-only">Latest entries</h2>}
  <SearchBar hideBesideRail={flush} />
  <slot name="before" />

  {groups.length === 0 && emptyText && <p class="empty">{emptyText}</p>}
  {groups.map((group) => (
    <MonthGroup group={group} />
  ))}

  <Pagination current={page.currentPage} last={page.lastPage} prevUrl={page.url.prev} nextUrl={page.url.next} />
</Container>

<style>
  .empty {
    color: var(--muted);
  }
</style>
