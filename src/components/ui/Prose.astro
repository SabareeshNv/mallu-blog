---
/**
 * Typography for rendered Markdown. The body is marked with its language, so Malayalam
 * automatically picks up Arima and its taller line heights.
 */
import { SITE } from '@/config/site';

interface Props {
  /** "regular" for lists and short notes, "large" for long-form reading, "xl" for a short note on its own page. */
  size?: 'regular' | 'large' | 'xl';
  lang?: string;
}

const { size = 'regular', lang = SITE.postLang } = Astro.props;
---

<div class:list={['prose', size]} lang={lang}>
  <slot />
</div>

<style>
  .prose {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    overflow-wrap: break-word;
  }

  .prose.large {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
  }

  .prose.xl {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }

  /* One rhythm for every block: the gap after a block is always 24px. */
  .prose :global(:where(p, ul, ol, blockquote, pre, figure, table)) {
    margin: 0 0 var(--space-6);
  }

  .prose > :global(:last-child) {
    margin-bottom: 0;
  }

  .prose :global(h2),
  .prose :global(h3) {
    margin: var(--space-12) 0 var(--space-4);
    font-weight: var(--fw-bold);
  }

  .prose :global(h2) {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
  }

  .prose :global(h3) {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }

  .prose > :global(:first-child) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--space-6);
  }

  .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(li::marker) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    padding-inline-start: var(--space-5);
    border-inline-start: 2px solid var(--accent);
    color: var(--muted);
  }

  .prose :global(img) {
    margin: var(--space-8) 0;
  }

  .prose :global(hr) {
    width: var(--space-16);
    margin: var(--space-12) auto;
    border: 0;
    border-top: 2px solid var(--border);
  }

  .prose :global(code) {
    padding: 0 var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--surface-strong);
    font-size: 0.875em;
  }

  .prose :global(pre) {
    padding: var(--space-4);
    overflow-x: auto;
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: var(--fs-meta);
    line-height: var(--lh-meta);
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
</style>
