---
import { formatDate, isoDate } from '@/lib/format';

interface Props {
  date: Date;
  /** "long" → 12 March 2026, "medium" → 12 Mar 2026, "short" → 12 Mar */
  format?: 'long' | 'medium' | 'short';
  class?: string;
}

const { date, format = 'long', class: className } = Astro.props;
---

<time class={className} datetime={isoDate(date)}>
  {formatDate(date, format)}
</time>
