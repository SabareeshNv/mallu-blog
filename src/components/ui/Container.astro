---
/**
 * The page-width wrapper: centres its content in a column and applies the page's side margins.
 *
 *   size="feed"   the width of lists (Essays, Scribbles, Archive, Topics)
 *   size="wide"    the home page: the writing and its side column (HomeShell)
 *   size="flush"   no width, margin or padding: a list placed inside another container
 *   size="reading" the width of reading text: 75ch, measured in the text's own font (Malayalam by default, or
 *                 `lang="en"` for English pages), so a line holds about the same number of characters in each
 *   top           space above the content: the default is 48px; "tight" is 32px; "none" is 0
 */
interface Props {
  size: 'feed' | 'reading' | 'wide' | 'flush';
  /** The language of the reading text; decides which font the 75ch is measured in. */
  lang?: 'ml' | 'en';
  top?: 'default' | 'tight' | 'none';
  /** The element to render. */
  as?: 'div' | 'article' | 'section';
}

const { size, lang = 'ml', top = 'default', as: Tag = 'div' } = Astro.props;
---

<Tag class:list={['container', size, size === 'reading' && `reading-${lang}`, top]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding: var(--space-12) var(--gutter) 0;
  }

  .feed {
    max-width: calc(var(--container-feed) + 2 * var(--gutter));
  }

  /* Set in the reading font and size, so that "ch" below means characters of the text itself. */
  .reading {
    max-width: calc(var(--measure-reading) + 2 * var(--gutter));
  }

  .reading-ml {
    font-family: var(--font-post);
    font-size: var(--fs-lead);
  }

  .reading-en {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
  }

  .wide {
    max-width: calc(var(--container-wide) + 2 * var(--gutter));
  }

  .flush {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .tight {
    padding-top: var(--space-8);
  }

  .none {
    padding-top: 0;
  }
</style>
