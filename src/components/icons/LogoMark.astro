---
/** The Lone Voice mark: a speech bubble holding a single hand-drawn wave of voice. */
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
---

<svg viewBox="0 0 100 100" width={size} height={size} fill="none" aria-hidden="true" focusable="false">
  <path
    class="outline"
    d="M22 17 C7 29 10 60 27 73 L22 91 L43 77 C66 84 88 67 88 46 C88 22 68 9 46 12 C37 12 29 14 22 17Z"
    stroke-width="4"
    stroke-linejoin="round"
  ></path>
  <path
    class="wave"
    d="M27 48 C35 48 35 31 43 31 C51 31 48 66 58 66 C67 66 66 40 77 40"
    stroke-width="4"
    stroke-linecap="round"
  ></path>
  <circle class="dot" cx="77" cy="40" r="3"></circle>
</svg>

<style>
  /* Colours come from the theme tokens, so the outline and wave follow the palette in both themes. */
  .outline {
    stroke: var(--logo-outline);
  }

  .wave {
    stroke: var(--logo-wave);
  }

  .dot {
    fill: var(--logo-outline);
  }
</style>
