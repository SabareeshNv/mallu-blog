---
/** The Lone Voice mark: a single quotation mark (the lone voice) standing on a quiet horizon. */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="14" fill="#211f2c"></rect>
  <path d="M31 35 A9 9 0 1 1 41 26 C41 36 35 43 25 47 C29 42 31 38 31 35 Z" fill="#ff6b4a"></path>
  <path d="M16 53 H48" stroke="#f4f2ee" stroke-width="2.5" stroke-linecap="round" opacity=".55"></path>
</svg>
