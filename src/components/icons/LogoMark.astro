---
/** The Lone Voice mark: a single voice (gold dot) and its two sound waves. */
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="16" fill="#0a6c67"></rect>
  <circle cx="22" cy="32" r="7" fill="#f6c453"></circle>
  <path d="M34 22a14 14 0 0 1 0 20M41 15a24 24 0 0 1 0 34" fill="none" stroke="#e6efee" stroke-width="4.5"
    stroke-linecap="round"></path>
</svg>
