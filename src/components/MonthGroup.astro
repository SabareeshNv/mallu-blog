---
import EssayEntry from './EssayEntry.astro';
import ScribbleEntry from './ScribbleEntry.astro';
import EssayIcon from './icons/EssayIcon.astro';
import ScribbleIcon from './icons/ScribbleIcon.astro';
import { isEssay, type Group } from '../lib/posts';

interface Props {
  group: Group<string>;
}

const { group } = Astro.props;
const headingId = `month-${group.key}`;
const [year, month] = group.key.split('-');
const monthName = new Intl.DateTimeFormat('en-GB', { month: 'long', timeZone: 'UTC' }).format(
  new Date(Date.UTC(Number(year), Number(month) - 1, 1)),
);
---

<section class="month" aria-labelledby={headingId}>
  <h2 id={headingId} class="heading">
    {monthName} <span class="year">{year}</span>
  </h2>
  <ol class="timeline" role="list">
    {
      group.posts.map((post) => {
        const essay = isEssay(post);
        return (
          <li class:list={['item', essay ? 'is-essay' : 'is-scribble']}>
            <span class="node" aria-hidden="true">
              {essay ? <EssayIcon size={16} /> : <ScribbleIcon size={16} />}
            </span>
            {essay ? <EssayEntry post={post} /> : <ScribbleEntry post={post} />}
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  .month + .month {
    margin-top: var(--space-16);
  }

  .heading {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--fs-h2);
    font-weight: var(--fw-heavy);
    line-height: var(--lh-h2);
    letter-spacing: -0.02em;
  }

  .year {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--bg);
    font-size: var(--fs-label);
    font-weight: var(--fw-bold);
    line-height: var(--lh-label);
    letter-spacing: var(--tracking-label);
  }

  /* A quiet vertical rail links the month's entries. Node: 32px; offset: 48px (40px on phones). */
  .timeline {
    --node: var(--space-8);
    --offset: var(--space-12);
    position: relative;
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0 0 0 var(--offset);
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: var(--space-6);
    bottom: var(--space-6);
    left: calc(var(--node) / 2 - 1px);
    width: 2px;
    background: var(--rail);
  }

  .item {
    position: relative;
  }

  /* Centred on the first line of text in a scribble panel (24px padding + 32px line). */
  .node {
    position: absolute;
    top: var(--space-6);
    left: calc(-1 * var(--offset));
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 2px solid currentColor;
    border-radius: var(--radius-full);
    background: var(--bg);
  }

  .node :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
  }

  .is-essay .node {
    color: var(--essay);
    background: var(--essay-soft);
  }

  .is-scribble .node {
    color: var(--accent);
    background: var(--accent-soft);
  }

  @media (max-width: 40rem) {
    .timeline {
      --offset: var(--space-10);
    }
  }
</style>
